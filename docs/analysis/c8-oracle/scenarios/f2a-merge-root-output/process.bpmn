<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-OPS-30 F2a — слияние переменных completion ПРИ НАЛИЧИИ output-маппинга.
     У задания 'work' объявлен output-маппинг o = =c, а воркер возвращает {c:"C"}.
     В Camunda 8 задание с output-маппингами НЕ сливает переменные completion в
     родительский скоуп автоматически — наружу уходят только отображённые выходы. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_f2aMergeRootOutput" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="f2aMergeRootOutput" name="f2aMergeRootOutput" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="work" />
    <bpmn:serviceTask id="work" name="work">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2aWork" />
        <zeebe:ioMapping>
          <zeebe:output source="=c" target="o" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="work" targetRef="dump" />
    <bpmn:serviceTask id="dump" name="dump">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2aDump" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="dump" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
