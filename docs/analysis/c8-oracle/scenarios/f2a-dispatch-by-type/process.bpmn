<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-OPS-30 F2a — диспатч по типу: два задания с РАЗНЫМИ типами
     (f2aTypeA / f2aTypeB). Воркер, подписанный на один тип, не должен получать
     задания другого типа. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_f2aDispatchByType" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="f2aDispatchByType" name="f2aDispatchByType" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="workA" />
    <bpmn:serviceTask id="workA" name="workA">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2aTypeA" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="workA" targetRef="workB" />
    <bpmn:serviceTask id="workB" name="workB">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2aTypeB" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="workB" targetRef="dump" />
    <bpmn:serviceTask id="dump" name="dump">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2aDump" />
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f4" sourceRef="dump" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f4</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
