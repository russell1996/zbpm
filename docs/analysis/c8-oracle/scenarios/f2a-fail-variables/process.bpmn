<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-OPS-30 F2a — fail ПЕРЕМЕННЫМИ: по документации 8.9 переменные при отказе
     создаются ТОЛЬКО в локальном скоупе задания (в root не попадают), и
     воркер может отдать вместе с отказомpartial-результат. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_f2aFailVariables" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="f2aFailVariables" name="f2aFailVariables" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="work" />
    <bpmn:serviceTask id="work" name="work">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2aWork" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="work" targetRef="dump" />
    <bpmn:serviceTask id="dump" name="dump">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2aDump" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="dump" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
