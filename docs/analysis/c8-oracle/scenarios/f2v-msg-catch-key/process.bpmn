<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-OPS-30 Ф2в — сообщение: приём с ключом корреляции.
     У сообщения — zeebe:subscription correlationKey (Camunda 8.5 держит подписку
     на СООБЩЕНИИ; наш движок читает оттуда же — BpmnParseServiceImpl:83-91).
     Публикация с чужим ключом не должна будить подписку; с правильным — должна. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_f2vCatchKey" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Msg_Catch" name="f2v-catch-msg">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="f2vCatchKey" name="f2vCatchKey" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="catch1" />
    <bpmn:intermediateCatchEvent id="catch1" name="catch1">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med1" messageRef="Msg_Catch" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f2" sourceRef="catch1" targetRef="afterCatch" />
    <bpmn:serviceTask id="afterCatch" name="afterCatch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2vAfterCatchKey" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="afterCatch" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
