<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-41 S9 (CORRECTED 2026-10-13): completionCondition is a CHILD element of
     multiInstanceLoopCharacteristics (BPMN standard), NOT an attribute of
     zeebe:loopCharacteristics. The first version used the attribute form and Zeebe
     silently ignored it (all probes inert, incl. "=true").
     Q: does Zeebe 8.5.0 terminate remaining instances when the condition fires? -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="defs-s9" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="s9MiSub" name="S9 MI subprocess completionCondition" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="miSub" />
    <bpmn:subProcess id="miSub" name="mi">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection='=["a","b","c"]' inputElement="item"
                                     outputCollection="results" outputElement="=item" />
        </bpmn:extensionElements>
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">=numberOfCompletedInstances >= 1</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="subStart"><bpmn:outgoing>sf1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sequenceFlow id="sf1" sourceRef="subStart" targetRef="w" />
      <bpmn:serviceTask id="w" name="w">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="s9w" />
        </bpmn:extensionElements>
        <bpmn:incoming>sf1</bpmn:incoming>
        <bpmn:outgoing>sf2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="sf2" sourceRef="w" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd"><bpmn:incoming>sf2</bpmn:incoming></bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f2" sourceRef="miSub" targetRef="dump" />
    <bpmn:serviceTask id="dump" name="dump">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="s9dump" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="dump" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
