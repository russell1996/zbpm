<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-41 S1: parallel MI subProcess over ["a","b","c"], inside w -> w2.
     w completes with tu="tu-"+item WITHOUT output mapping.
     Q: where does tu land? what does w2 see in each branch? results order on reverse completion? -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="defs-s1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="s1MiSub" name="S1 MI subprocess race" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="miSub" />
    <bpmn:subProcess id="miSub" name="mi">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection='=["a","b","c"]' inputElement="item"
                                     outputCollection="results" outputElement="=tu" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="subStart"><bpmn:outgoing>sf1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sequenceFlow id="sf1" sourceRef="subStart" targetRef="w" />
      <bpmn:serviceTask id="w" name="w">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="s1w" />
        </bpmn:extensionElements>
        <bpmn:incoming>sf1</bpmn:incoming>
        <bpmn:outgoing>sf2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="sf2" sourceRef="w" targetRef="w2" />
      <bpmn:serviceTask id="w2" name="w2">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="s1w2" />
        </bpmn:extensionElements>
        <bpmn:incoming>sf2</bpmn:incoming>
        <bpmn:outgoing>sf3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="sf3" sourceRef="w2" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd"><bpmn:incoming>sf3</bpmn:incoming></bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f2" sourceRef="miSub" targetRef="dump" />
    <bpmn:serviceTask id="dump" name="dump">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="s1dump" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="dump" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
