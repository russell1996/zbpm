<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-41 S7: interrupting timer boundary (3s) on MI subprocess with unfinished jobs.
     Q: outputCollection passed to parent? are instance jobs canceled?
     dump tasks carry path="ok"/"cancel" via input mapping to tell branches apart. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="defs-s7" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="s7MiSub" name="S7 MI subprocess interrupting boundary" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="miSub" />
    <bpmn:subProcess id="miSub" name="mi">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection='=["a","b"]' inputElement="item"
                                     outputCollection="results" outputElement="=item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="subStart"><bpmn:outgoing>sf1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sequenceFlow id="sf1" sourceRef="subStart" targetRef="w" />
      <bpmn:serviceTask id="w" name="w">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="s7w" />
        </bpmn:extensionElements>
        <bpmn:incoming>sf1</bpmn:incoming>
        <bpmn:outgoing>sf2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="sf2" sourceRef="w" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd"><bpmn:incoming>sf2</bpmn:incoming></bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="bndTimer" attachedToRef="miSub" cancelActivity="true">
      <bpmn:outgoing>fCancel</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT3S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f2" sourceRef="miSub" targetRef="dumpOk" />
    <bpmn:sequenceFlow id="fCancel" sourceRef="bndTimer" targetRef="dumpCancel" />
    <bpmn:serviceTask id="dumpOk" name="dumpOk">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="s7dump" />
        <zeebe:ioMapping>
          <zeebe:input source='="ok"' target="path" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="dumpOk" targetRef="end" />
    <bpmn:serviceTask id="dumpCancel" name="dumpCancel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="s7dump" />
        <zeebe:ioMapping>
          <zeebe:input source='="cancel"' target="path" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>fCancel</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f4" sourceRef="dumpCancel" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
