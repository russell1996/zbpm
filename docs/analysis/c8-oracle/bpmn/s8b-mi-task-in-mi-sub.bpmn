<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-41 S8b: MI service task inside MI subprocess.
     Q: does the inner MI task see the outer instance's item? inner task MI over
     literal ["p","q"] with inputElement pitem; task output pitem -> tresults. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="defs-s8b" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="s8bMiTaskInSub" name="S8b MI task in MI subprocess" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="miSub" />
    <bpmn:subProcess id="miSub" name="mi">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection='=["a","b"]' inputElement="item"
                                     outputCollection="results" outputElement="=tresults" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="subStart"><bpmn:outgoing>sf1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sequenceFlow id="sf1" sourceRef="subStart" targetRef="mtask" />
      <bpmn:serviceTask id="mtask" name="mtask">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="s8bw" />
        </bpmn:extensionElements>
        <bpmn:incoming>sf1</bpmn:incoming>
        <bpmn:outgoing>sf2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection='=["p","q"]' inputElement="pitem"
                                       outputCollection="tresults" outputElement="=pitem" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="sf2" sourceRef="mtask" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd"><bpmn:incoming>sf2</bpmn:incoming></bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f2" sourceRef="miSub" targetRef="dump" />
    <bpmn:serviceTask id="dump" name="dump">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="s8bdump" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="dump" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
