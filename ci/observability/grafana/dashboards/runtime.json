{
  "id": null,
  "uid": "runtime",
  "title": "ZorroBPM — Runtime",
  "tags": ["zorrobpm"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(instance)",
        "datasource": "Prometheus",
        "current": {"text": "All", "value": "$__all"},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "JVM — heap used / max",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "heap used"},
        {"expr": "jvm_memory_max_bytes{area=\"heap\"}", "legendFormat": "heap max"}
      ]
    },
    {
      "id": 2,
      "title": "JVM — GC pause",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(jvm_gc_pause_seconds_sum[5m])", "legendFormat": "gc pause"}
      ]
    },
    {
      "id": 3,
      "title": "JVM — threads",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "jvm_threads_live_threads", "legendFormat": "live"},
        {"expr": "jvm_threads_daemon_threads", "legendFormat": "daemon"}
      ]
    },
    {
      "id": 4,
      "title": "Hikari — active / idle / pending / max / timeout",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "hikaricp_connections_active", "legendFormat": "active"},
        {"expr": "hikaricp_connections_idle", "legendFormat": "idle"},
        {"expr": "hikaricp_connections_pending", "legendFormat": "pending"},
        {"expr": "hikaricp_connections_max", "legendFormat": "max"},
        {"expr": "rate(hikaricp_connections_timeout_total[5m])", "legendFormat": "timeout rate"}
      ]
    },
    {
      "id": 5,
      "title": "Tomcat — threads busy / max + connections",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "tomcat_threads_busy_threads", "legendFormat": "busy"},
        {"expr": "tomcat_threads_config_max_threads", "legendFormat": "max"},
        {"expr": "tomcat_connections_current_connections", "legendFormat": "connections"}
      ]
    },
    {
      "id": 6,
      "title": "HTTP — rate by status, p95 latency, 5xx rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(http_server_requests_seconds_count[5m])", "legendFormat": "{{status}}"},
        {"expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])", "legendFormat": "5xx"}
      ]
    },
    {
      "id": 7,
      "title": "RabbitMQ — connections / channels / unroutable",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rabbitmq_connections", "legendFormat": "connections"},
        {"expr": "rabbitmq_channels", "legendFormat": "channels"},
        {"expr": "rate(rabbitmq_channel_messages_unroutable_returned_total[5m])", "legendFormat": "unroutable"}
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
