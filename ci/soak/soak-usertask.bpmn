<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_soak_usertask" targetNamespace="http://bpmn.io/schema/bpmn">
  <!--
    WO-SCALE-3 fixture. Plain start -> userTask -> end, no timer. Started
    via nginx round-robin from many "clients"; the resulting user tasks
    are completed in batches, each completion aimed at a different direct
    replica port than the one that likely handled the start — this is the
    no-sticky-session cross-replica correctness proof for the ordinary
    request path (not timers, not SSE).
  -->
  <bpmn:process id="soak-usertask" name="soak-usertask" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="userTask1" />
    <bpmn:userTask id="userTask1" name="userTask1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="userTask1" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
