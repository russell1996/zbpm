<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_soak_boundary" targetNamespace="http://bpmn.io/schema/bpmn">
  <!--
    WO-SCALE-3 fixture. Each start creates one instance sitting on
    userTask1 with a short INTERRUPTING boundary timer. Under N replicas,
    exactly one replica's scheduler must win the SKIP LOCKED race and fire
    it exactly once: the instance must end at escalationEnd exactly once,
    never at both endEvent and escalationEnd, never twice.
  -->
  <bpmn:process id="soak-boundary" name="soak-boundary" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="userTask1" />
    <bpmn:userTask id="userTask1" name="userTask1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="userTask1" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="boundary1" name="boundary1" attachedToRef="userTask1" cancelActivity="true">
      <bpmn:outgoing>flowB</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_soak_b">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="boundary1" targetRef="escalationEnd" />
    <bpmn:endEvent id="escalationEnd" name="escalationEnd">
      <bpmn:incoming>flowB</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
