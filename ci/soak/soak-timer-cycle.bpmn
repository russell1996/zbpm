<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_soak_timer_cycle" targetNamespace="http://bpmn.io/schema/bpmn">
  <!--
    WO-SCALE-3 fixture. ONE deployment, repeating start timer (every 5s).
    Every cycle must spawn exactly one new process instance, cluster-wide,
    regardless of which replica's scheduler picks it up — this is the
    sharpest exactly-once-dispatch proof in the rig: unlike the boundary
    timer above, there is no per-request client driving it, so any
    double-fire is a pure server-side race, not a script bug.
  -->
  <bpmn:process id="soak-timer-cycle" name="soak-timer-cycle" isExecutable="true">
    <bpmn:startEvent id="timerStart" name="timerStart">
      <bpmn:outgoing>flow1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_soak_cycle">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="timerStart" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
