<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath />
    </parent>

    <properties>
        <!-- WO-SEC-36: override Spring Framework 7.0.6→7.0.8 to fix CVE-2026-41855 (CVSS 9.8).
             Spring Boot 4.0.5 BOM pins 7.0.6 by default; 7.0.8 is the patched GA per advisory. -->
        <spring-framework.version>7.0.8</spring-framework.version>
        <!-- WO-SEC-37: override jackson-2 BOM 2.21.2→2.22.1 to fix CVE-2026-54512/54513 (CVSS 8.1).
             Spring Boot 4.0.6 BOM pins jackson-2-bom 2.21.2; 2.22.1 is the patched release.
             (2.21.3 still carried CVE-2026-54512/54513 per dependency-check scan.) -->
        <jackson-2-bom.version>2.22.1</jackson-2-bom.version>
        <!-- WO-SEC-37: override jackson 3.x BOM 3.1.0→3.2.1 to fix CVE-2026-54512/54513 (CVSS 8.1).
             Spring Boot 4.0.6 BOM pins jackson-bom 3.1.2; 3.2.1 is the patched release.
             (3.1.2 still carried CVE-2026-54512/54513 per dependency-check scan.) -->
        <jackson-bom.version>3.2.1</jackson-bom.version>
        <!-- WO-SEC-37: override postgresql 42.7.10→42.7.13 to fix CVE-2026-42198 (7.5) / CVE-2026-54291 (8.2).
             Spring Boot 4.0.6 BOM pins postgresql 42.7.10; 42.7.13 is the patched release.
             (42.7.11 fixed CVE-2026-42198 but not CVE-2026-54291 per dependency-check scan.) -->
        <postgresql.version>42.7.13</postgresql.version>
    </properties>

    <groupId>com.zorrodev.bpm</groupId>
    <artifactId>zorrobpm</artifactId>
    <version>0.7.17-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ZorroBPM</name>
    <description>ZorroBPM Community Edition: a lightweight Spring Boot based BPM engine.</description>
    <url>https://zorrobpm.dev</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>maratkalibek</id>
            <name>Marat Kalibekov</name>
            <email>marat@zorrobpm.dev</email>
            <organization>ZorroBPM</organization>
            <organizationUrl>https://zorrobpm.dev</organizationUrl>
        </developer>
    </developers>

    <modules>
        <module>zorrobpm-contract</module>
        <module>zorrobpm-client</module>
        <module>zorrobpm-engine</module>
        <module>zorrobpm-rest</module>
        <module>zorrobpm-job-handler-spring-boot-starter</module>
        <module>zorrobpm-test</module>
        <module>zorrobpm-exchange</module>
        <module>zorrobpm-rabbitmq</module>
        <module>zorrobpm-ce</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- WO-SEC-36: Force spring-framework 7.0.8 to override BOM default 7.0.6 -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>7.0.8</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                </configuration>
            </plugin>
            <!-- WO-SEC-32: OWASP dependency-check — invoked via CLI in CI security job -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.1.1</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <suppressionFiles>
                        <suppressionFile>owasp-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <nodeAuditSkipDevDependencies>true</nodeAuditSkipDevDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <scm>
        <connection>scm:git:https://github.com/zorrobpm/zorrobpm-ce.git</connection>
        <developerConnection>scm:git:https://github.com/zorrobpm/zorrobpm-ce.git</developerConnection>
        <url>https://github.com/zorrobpm/zorrobpm-ce.git</url>
        <tag>v0.7.14</tag>
    </scm>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <doclint>none</doclint>
                                    <failOnError>false</failOnError>
                                    <quiet>true</quiet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
