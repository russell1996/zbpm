<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zorrodev.bpm</groupId>
        <artifactId>zorrobpm</artifactId>
        <version>0.8.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.zorrodev.bpm</groupId>
    <artifactId>zorrobpm-engine</artifactId>
    <version>0.8.0-SNAPSHOT</version>

    <name>zorrobpm-engine</name>
    <description>ZBPM: a lightweight Spring Boot based BPM engine.</description>
    <url>https://zorrobpm.dev</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>maratkalibek</id>
            <name>Marat Kalibekov</name>
            <email>marat@zorrodev.com</email>
            <organizationUrl>https://zorrodev.com</organizationUrl>
        </developer>
    </developers>

    <properties>
        <!-- WO-SEC-53 (A6): the project's declared/CI/runtime stack is Java 21
             (root Dockerfile uses maven:3.9.9-eclipse-temurin-21 + eclipse-temurin:21-jre,
             .gitlab-ci.yml runs maven:3.9.9-eclipse-temurin-21). 17 was a stale leftover. -->
        <java.version>21</java.version>
        <!-- Tag groups excluded from failsafe. Default excludes the PG-only tests so the
             standard build stays on H2. The test:pg CI job clears this (-Dzbpm.excludedGroups=)
             and adds -Dgroups=pg to run the @Tag("pg") PG-IT against a real postgres.
             WO-TEST-10: chaos-teсты (@Tag("chaos")) тоже исключены по умолчанию — им нужна
             живая chaos-топология (toxiproxy + kill-доступ к docker), гоняются только через
             ci/run-chaos-tests.sh (-Dgroups=chaos -Dzbpm.excludedGroups=). -->
        <zbpm.excludedGroups>pg | chaos</zbpm.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- WO-INT-5: mail transport (JavaMailSender, MimeMessage, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>

        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- WO-VM-5: JSON Schema 2020-12 validation for VARIABLE_SCHEMA artifacts -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.4</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>

        <dependency>
            <groupId>org.camunda.feel</groupId>
            <artifactId>feel-engine</artifactId>
            <version>1.19.3</version>
        </dependency>

        <dependency>
            <groupId>com.zorrodev.bpm</groupId>
            <artifactId>zorrobpm-contract</artifactId>
            <version>0.8.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- WO-OPS-11 п.2: Awaitility для polling-ожиданий вместо Thread.sleep
             (прецедента в проекте не было — стандартный безопасный выбор из Maven Central,
             тест-скоп, прод-код не затрагивает). -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.3.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.zorrodev.bpm</groupId>
            <artifactId>zorrobpm-exchange</artifactId>
            <version>0.8.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <!-- WO-OBS-1: micrometer for business metrics (versions from Boot BOM) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- WO-OBS-8: native Boot OTel starter (not the javaagent, not the community
             starter — see escalation). Single dep: OTel API + micrometer-tracing-bridge-otel
             + OTLP HTTP/protobuf exporter + OTLP metrics registry, versions from Boot BOM.
             No OTLP endpoint in repo → SDK no-op by default (prod/CI silent); endpoint +
             sampling only via dev-overlay env.
             WO-OBS-8r3: micrometer-registry-otlp EXCLUDED (CVE-2026-0994, 8.2, in its
             transitive protobuf-java:4.32.0 — the ONLY protobuf-java path in this tree,
             verified by dependency:tree; the span exporter needs no protobuf at all,
             exporter-otlp-common has exactly one dep: exporter-common). Our metrics go
             to Prometheus (micrometer-registry-prometheus, PrometheusActuatorAppTest),
             nothing configures OTLP metrics export and no code references
             OtlpMeterRegistry — Boot's OtlpMeterRegistryConfiguration backs off on
             @ConditionalOnClass. Span export to dev Jaeger (criterion 1) is unaffected:
             opentelemetry-exporter-otlp + sender-okhttp stay, with kotlin-stdlib pinned
             to patched 2.4.20 in the root pom. Exclusion (not suppression): the flagged
             bytes leave the classpath entirely instead of being risk-accepted. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-registry-otlp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- WO-OBS-8, test-only: in-memory span exporter for trace-continuity asserts
             (criterion 1) — version pinned to the OTel release Boot 4.0.6 manages
             (1.55.0, verified resolvable from Maven Central 2026-09-17). -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <version>1.55.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>**/*IntegrationTests.java</excludes>
                    <useSystemClassLoader>false</useSystemClassLoader>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IntegrationTests.java</include>
                        <include>**/*PgIT.java</include>
                        <include>**/*ChaosIT.java</include>
                    </includes>
                    <!-- Exclude PG-only tests by default (H2 build); test:pg clears this via
                         -Dzbpm.excludedGroups= and selects them with -Dgroups=pg. A literal here
                         is NOT overridable by -D, so it must be a property (proven: -Dgroups=pg
                         alone left failsafe at "Tests run: 0"). -->
                    <excludedGroups>${zbpm.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- WO-PERF-4: jacoco (prepare-agent instrumentation + report) is expensive on every
             local run and only needed for coverage measurement. Default OFF; CI enables it via
             `-Pcoverage` (see .gitlab-ci.yml test:backend / Dockerfile test stage). -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.14</version>
                        <configuration>
                            <excludes>
                                <exclude>com/zorrodev/bpm/engine/entity/*</exclude>
                                <exclude>com/zorrodev/bpm/engine/bpmn/**</exclude>
                                <exclude>com/zorrodev/bpm/engine/event/**</exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <id>coverage-initialize</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>coverage-report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                            <!-- WO-OPS-11 п.3: реальный гейт, не просто отчёт. Пороги по
                                 факту замера полного verify -Pcoverage (2026-09-16):
                                 LINE 0.694 / BRANCH 0.539 — выставлено 0.65/0.50
                                 (запас вниз от факта, не занижение ради прохождения:
                                 аудит предлагал 0.70/0.60 — LINE совпадает почти,
                                 BRANCH взят ниже факта, иначе красный на мастере). -->
                            <execution>
                                <id>coverage-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.65</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.50</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <doclint>none</doclint>
                                    <failOnError>false</failOnError>
                                    <quiet>true</quiet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

  <scm>
    <tag>v0.7.14</tag>
  </scm>
</project>
