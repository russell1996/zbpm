<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-47 (P5): внутри подпроцесса две последовательные ветви — быстрая идёт
     к error end, медленная (задача с boundary-таймером PT10M) гасится
     прерывающей error-границей подпроцесса. Проверяется, что после завершения
     инстанса не остаётся armed-таймера на живой activity (таймер погашенной
     задачи — trimmed-хвост на CANCELLED, не нарушение).
     ВНИМАНИЕ: здесь НЕТ parallel-форка внутри подпроцесса намеренно — бросок
     error end с ветви null-scope форк-токена движок не доставляет на границу
     scope (тихий unhandled + инцидент, V7-находка C8-47 §V7.1, отдельный WO).
     Такая топология проверяет снятие таймера, а не доставку error. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="defs-c847-err" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:error id="bizErr" name="Business Error" errorCode="E-847" />
  <bpmn:process id="c847-error" name="C8-47 error with timer" isExecutable="true">
    <bpmn:startEvent id="startEvent"><bpmn:outgoing>flow1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" sourceRef="startEvent" targetRef="sub1" />
    <bpmn:subProcess id="sub1" name="sub1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:startEvent id="subStart"><bpmn:outgoing>subF0</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sequenceFlow id="subF0" sourceRef="subStart" targetRef="slowTask" />
      <bpmn:userTask id="slowTask" name="slowTask">
        <bpmn:incoming>subF0</bpmn:incoming>
        <bpmn:outgoing>subF1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="subF1" sourceRef="slowTask" targetRef="fastTask" />
      <bpmn:userTask id="fastTask" name="fastTask">
        <bpmn:incoming>subF1</bpmn:incoming>
        <bpmn:outgoing>subF3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="subF3" sourceRef="fastTask" targetRef="subErrEnd" />
      <bpmn:endEvent id="subErrEnd" name="subErrEnd">
        <bpmn:incoming>subF3</bpmn:incoming>
        <bpmn:errorEventDefinition id="ed1" errorRef="bizErr" />
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="slowTimeout" name="slowTimeout" attachedToRef="slowTask" cancelActivity="true">
        <bpmn:outgoing>subFlowTimeout</bpmn:outgoing>
        <bpmn:timerEventDefinition id="tmrDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="subFlowTimeout" sourceRef="slowTimeout" targetRef="subTimeoutEnd" />
      <bpmn:endEvent id="subTimeoutEnd" name="subTimeoutEnd">
        <bpmn:incoming>subFlowTimeout</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="errBoundary" name="errBoundary" attachedToRef="sub1">
      <bpmn:outgoing>flowB</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ed2" errorRef="bizErr" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowB" sourceRef="errBoundary" targetRef="boundaryEnd" />
    <bpmn:endEvent id="boundaryEnd" name="boundaryEnd">
      <bpmn:incoming>flowB</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow2" sourceRef="sub1" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
