<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-41 parity S0: plain w -> w2 -> dump, NO MI (control).
     Zeebe fact: completion vars ARE visible downstream (tu at w2 and dump). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="defs-c841-s0" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c841s0plain" name="S0 plain chain" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="w" />
    <bpmn:serviceTask id="w" name="w">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="c841s0w" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="w" targetRef="w2" />
    <bpmn:serviceTask id="w2" name="w2">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="c841s0w2" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="w2" targetRef="dump" />
    <bpmn:serviceTask id="dump" name="dump">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="c841s0dump" />
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f4" sourceRef="dump" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f4</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
