<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_c835_m1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c835-partial-merge" name="test-c835-partial-merge" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="isplit" />

    <!-- WO-C8-35 (MAJOR-1): 3 unconditional branches; A,B converge on j1, C bypasses into j2.
         The old counter wrote expected = activated.size() = 3 onto j1, which only ever sees 2
         arrivals \u2014 j1 then never fired and the instance hung. -->
    <bpmn:inclusiveGateway id="isplit" name="isplit">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>fA</bpmn:outgoing>
      <bpmn:outgoing>fB</bpmn:outgoing>
      <bpmn:outgoing>fC</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="fA" name="fA" sourceRef="isplit" targetRef="j1" />
    <bpmn:sequenceFlow id="fB" name="fB" sourceRef="isplit" targetRef="j1" />
    <bpmn:sequenceFlow id="fC" name="fC" sourceRef="isplit" targetRef="taskC" />

    <bpmn:inclusiveGateway id="j1" name="j1">
      <bpmn:incoming>fA</bpmn:incoming>
      <bpmn:incoming>fB</bpmn:incoming>
      <bpmn:outgoing>jOut</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="jOut" name="jOut" sourceRef="j1" targetRef="j2" />

    <bpmn:userTask id="taskC" name="taskC">
      <bpmn:incoming>fC</bpmn:incoming>
      <bpmn:outgoing>gC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="gC" name="gC" sourceRef="taskC" targetRef="j2" />

    <bpmn:inclusiveGateway id="j2" name="j2">
      <bpmn:incoming>jOut</bpmn:incoming>
      <bpmn:incoming>gC</bpmn:incoming>
      <bpmn:outgoing>fAfter</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="fAfter" name="fAfter" sourceRef="j2" targetRef="taskAfter" />
    <bpmn:userTask id="taskAfter" name="taskAfter">
      <bpmn:incoming>fAfter</bpmn:incoming>
      <bpmn:outgoing>fEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fEnd" name="fEnd" sourceRef="taskAfter" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
