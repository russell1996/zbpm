<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_msgthrow" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-message-throw" name="test-message-throw" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="msgThrow" />
    <bpmn:intermediateThrowEvent id="msgThrow" name="msgThrow">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med1" messageRef="Msg_1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="msgThrow" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Msg_1" name="ping" />
</bpmn:definitions>
