<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_adhoc_fork" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-adhoc-nested-fork" name="test-adhoc-nested-fork" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="adhoc" />

    <bpmn:adHocSubProcess id="adhoc" name="adhoc">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:adHoc activeElementsCollection="=[&quot;taskX&quot;, &quot;taskZ&quot;]" />
      </bpmn:extensionElements>
      <bpmn:userTask id="taskX" name="taskX">
        <bpmn:outgoing>f2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="f2" name="f2" sourceRef="taskX" targetRef="fork" />
      <bpmn:parallelGateway id="fork" name="fork">
        <bpmn:incoming>f2</bpmn:incoming>
        <bpmn:outgoing>f3</bpmn:outgoing>
        <bpmn:outgoing>f4</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sequenceFlow id="f3" name="f3" sourceRef="fork" targetRef="taskA" />
      <bpmn:sequenceFlow id="f4" name="f4" sourceRef="fork" targetRef="taskB" />
      <bpmn:userTask id="taskA" name="taskA">
        <bpmn:incoming>f3</bpmn:incoming>
        <bpmn:outgoing>f5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="taskB" name="taskB">
        <bpmn:incoming>f4</bpmn:incoming>
        <bpmn:outgoing>f6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="f5" name="f5" sourceRef="taskA" targetRef="join" />
      <bpmn:sequenceFlow id="f6" name="f6" sourceRef="taskB" targetRef="join" />
      <bpmn:parallelGateway id="join" name="join">
        <bpmn:incoming>f5</bpmn:incoming>
        <bpmn:incoming>f6</bpmn:incoming>
        <bpmn:outgoing>f7</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sequenceFlow id="f7" name="f7" sourceRef="join" targetRef="taskY" />
      <bpmn:userTask id="taskY" name="taskY">
        <bpmn:incoming>f7</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:userTask id="taskZ" name="taskZ" />
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="f9" name="f9" sourceRef="adhoc" targetRef="endEvent" />

    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
