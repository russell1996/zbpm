<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_terminate_subscope" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-terminate-subscope" name="test-terminate-subscope" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="parallel1" />
    <bpmn:parallelGateway id="parallel1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flowA</bpmn:outgoing>
      <bpmn:outgoing>flowB</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flowA" name="flowA" sourceRef="parallel1" targetRef="outerTask" />
    <bpmn:userTask id="outerTask" name="outerTask">
      <bpmn:incoming>flowA</bpmn:incoming>
      <bpmn:outgoing>flowA2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flowA2" name="flowA2" sourceRef="outerTask" targetRef="endA" />
    <bpmn:endEvent id="endA" name="endA">
      <bpmn:incoming>flowA2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="parallel1" targetRef="sub1" />
    <bpmn:subProcess id="sub1" name="sub1">
      <bpmn:incoming>flowB</bpmn:incoming>
      <bpmn:outgoing>flowC</bpmn:outgoing>
      <bpmn:startEvent id="subStart" name="subStart">
        <bpmn:outgoing>subFlow1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="subFlow1" name="subFlow1" sourceRef="subStart" targetRef="innerTask" />
      <bpmn:userTask id="innerTask" name="innerTask">
        <bpmn:incoming>subFlow1</bpmn:incoming>
        <bpmn:outgoing>subFlow2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="subFlow2" name="subFlow2" sourceRef="innerTask" targetRef="subTerm" />
      <bpmn:endEvent id="subTerm" name="subTerm">
        <bpmn:incoming>subFlow2</bpmn:incoming>
        <bpmn:terminateEventDefinition id="TerminateDef_sub" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flowC" name="flowC" sourceRef="sub1" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flowC</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
