<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_adhoc_nocancel" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-adhoc-cancel-false" name="test-adhoc-cancel-false" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="adhoc" />

    <bpmn:adHocSubProcess id="adhoc" name="adhoc" cancelRemainingInstances="false">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:adHoc activeElementsCollection="=[&quot;taskD1&quot;, &quot;taskD2&quot;]" />
      </bpmn:extensionElements>
      <bpmn:completionCondition>=stopEarly = true</bpmn:completionCondition>
      <bpmn:userTask id="taskD1" name="taskD1" />
      <bpmn:userTask id="taskD2" name="taskD2" />
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="f4" name="f4" sourceRef="adhoc" targetRef="endEvent" />

    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
