<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_ute-assigned" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ute-assigned" name="User task assigned in the model" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>toApprove</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="approve" name="Approve">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="111" />
      </bpmn:extensionElements>
      <bpmn:incoming>toApprove</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="done">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="toApprove" sourceRef="start" targetRef="approve" />
    <bpmn:sequenceFlow id="toDone" sourceRef="approve" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
