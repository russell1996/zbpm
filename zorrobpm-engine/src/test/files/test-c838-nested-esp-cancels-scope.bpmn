<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_c838_nesp" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c838-nested-esp-cancels-scope" name="test-c838-nested-esp-cancels-scope" isExecutable="true">
    <!-- WO-C8-38 (C38-3): вложенный прерывающий ESP гасит свой РОДИТЕЛЬСКИЙ scope,
         а не весь инстанс. subOuter — embedded-подпроцесс: внутри taskIn (живая
         задача scope) и вложенный прерывающий message-ESP (espNested, триггер msgGo).
         Рядом на верхнем уровне — taskOutside (параллельная ветвь ВНЕ scope).
         Триггер espNested: taskIn и taskIdle отменены (они ВНУТРИ subOuter),
         taskOutside ЖИВ (он вне scope — scope-confinement, принцип C8-34), сам
         ESP-стартер пошёл (espTask CREATED), инстанс НЕ завершён. До C38-3
         triggerEventSubprocess делал cancelActiveActivities ВСЕГО инстанса:
         taskOutside тоже отменялся, а инстанс уходил в COMPLETED концом ESP —
         параллельная ветвь терялась молча. -->
    <bpmn:message id="mGo" name="mGo" />
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="pfork" />
    <bpmn:parallelGateway id="pfork" name="pfork">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>fSub</bpmn:outgoing>
      <bpmn:outgoing>fOut</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="fSub" name="fSub" sourceRef="pfork" targetRef="subOuter" />
    <bpmn:sequenceFlow id="fOut" name="fOut" sourceRef="pfork" targetRef="taskOutside" />

    <bpmn:subProcess id="subOuter" name="subOuter">
      <bpmn:incoming>fSub</bpmn:incoming>
      <bpmn:outgoing>fSubAfter</bpmn:outgoing>
      <bpmn:startEvent id="subStart" name="subStart">
        <bpmn:outgoing>fSubFork</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="fSubFork" name="fSubFork" sourceRef="subStart" targetRef="subFork" />
      <bpmn:parallelGateway id="subFork" name="subFork">
        <bpmn:incoming>fSubFork</bpmn:incoming>
        <bpmn:outgoing>fIn</bpmn:outgoing>
        <bpmn:outgoing>fIdle</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sequenceFlow id="fIn" name="fIn" sourceRef="subFork" targetRef="taskIn" />
      <bpmn:sequenceFlow id="fIdle" name="fIdle" sourceRef="subFork" targetRef="taskIdle" />
      <bpmn:userTask id="taskIn" name="taskIn">
        <bpmn:incoming>fIn</bpmn:incoming>
        <bpmn:outgoing>fInEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="fInEnd" name="fInEnd" sourceRef="taskIn" targetRef="subEnd" />
      <bpmn:userTask id="taskIdle" name="taskIdle">
        <bpmn:incoming>fIdle</bpmn:incoming>
        <bpmn:outgoing>fIdleEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="fIdleEnd" name="fIdleEnd" sourceRef="taskIdle" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd" name="subEnd">
        <bpmn:incoming>fInEnd</bpmn:incoming>
        <bpmn:incoming>fIdleEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="espNested" name="espNested" triggeredByEvent="true">
        <bpmn:startEvent id="espNestedStart" name="espNestedStart" isInterrupting="true">
          <bpmn:outgoing>fEspStart</bpmn:outgoing>
          <bpmn:messageEventDefinition id="espNestedMsg" messageRef="mGo" />
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="fEspStart" name="fEspStart" sourceRef="espNestedStart" targetRef="espTask" />
        <bpmn:userTask id="espTask" name="espTask">
          <bpmn:incoming>fEspStart</bpmn:incoming>
          <bpmn:outgoing>fEspEnd</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="espNestedEnd" name="espNestedEnd">
          <bpmn:incoming>fEspEnd</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="fEspEnd" name="fEspEnd" sourceRef="espTask" targetRef="espNestedEnd" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="fSubAfter" name="fSubAfter" sourceRef="subOuter" targetRef="endEvent" />

    <bpmn:userTask id="taskOutside" name="taskOutside">
      <bpmn:incoming>fOut</bpmn:incoming>
      <bpmn:outgoing>fOutEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fOutEnd" name="fOutEnd" sourceRef="taskOutside" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fSubAfter</bpmn:incoming>
      <bpmn:incoming>fOutEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
