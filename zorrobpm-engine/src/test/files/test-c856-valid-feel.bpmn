<?xml version="1.0" encoding="UTF-8"?>
<!--
  WO-C8-56: the SUPPORTED cousin of test-c856-invalid-feel-condition.bpmn — the SAME condition
  written with legal double quotes. The rejection must not eat working models: this one deploys.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="testC856ValidFeel" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flowToGateway</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw" name="Check return class">
      <bpmn:incoming>flowToGateway</bpmn:incoming>
      <bpmn:outgoing>flowMinor</bpmn:outgoing>
      <bpmn:outgoing>flowOther</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="endMinor">
      <bpmn:incoming>flowMinor</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endOther">
      <bpmn:incoming>flowOther</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flowToGateway" sourceRef="start" targetRef="gw" />
    <bpmn:sequenceFlow id="flowMinor" sourceRef="gw" targetRef="endMinor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=returnClass = "minor"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowOther" sourceRef="gw" targetRef="endOther" />
  </bpmn:process>
</bpmn:definitions>
