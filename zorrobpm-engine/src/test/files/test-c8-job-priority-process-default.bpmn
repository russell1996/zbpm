<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_c8prd" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c8-priority-default" name="c8-priority-default" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:jobPriorityDefinition priority="50" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="svc" />
    <bpmn:serviceTask id="svc" name="svc">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="job-c8" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="svc" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
