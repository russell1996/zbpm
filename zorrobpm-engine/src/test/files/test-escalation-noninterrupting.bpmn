<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_escni" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:escalation id="esc1" name="overdue" escalationCode="ESC-1" />
  <bpmn:process id="test-escalation-noninterrupting" name="test-escalation-noninterrupting" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="sub1" />
    <bpmn:subProcess id="sub1" name="sub1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:startEvent id="subStart" name="subStart">
        <bpmn:outgoing>subFlow1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="subFlow1" name="subFlow1" sourceRef="subStart" targetRef="subEscEnd" />
      <bpmn:endEvent id="subEscEnd" name="subEscEnd">
        <bpmn:incoming>subFlow1</bpmn:incoming>
        <bpmn:escalationEventDefinition id="eed1" escalationRef="esc1" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="escBoundary" name="escBoundary" attachedToRef="sub1" cancelActivity="false">
      <bpmn:outgoing>flowB</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="eed2" escalationRef="esc1" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="escBoundary" targetRef="boundaryEnd" />
    <bpmn:endEvent id="boundaryEnd" name="boundaryEnd">
      <bpmn:incoming>flowB</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="sub1" targetRef="mainEnd" />
    <bpmn:endEvent id="mainEnd" name="mainEnd">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
