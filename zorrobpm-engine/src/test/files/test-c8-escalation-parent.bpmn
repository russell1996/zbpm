<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_c8escp" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:escalation id="esc1" name="overdue" escalationCode="ESC-1" />
  <bpmn:process id="c8-escalation-parent" name="c8-escalation-parent" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="call" />
    <bpmn:callActivity id="call" name="call">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="c8-esc-child" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="catchAll" name="catchAll" attachedToRef="call">
      <bpmn:outgoing>flowCatch</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="eedCatch" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowCatch" name="flowCatch" sourceRef="catchAll" targetRef="endCatchAll" />
    <bpmn:endEvent id="endCatchAll" name="endCatchAll">
      <bpmn:incoming>flowCatch</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="specific" name="specific" attachedToRef="call">
      <bpmn:outgoing>flowSpec</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="eedSpec" escalationRef="esc1" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowSpec" name="flowSpec" sourceRef="specific" targetRef="endSpecific" />
    <bpmn:endEvent id="endSpecific" name="endSpecific">
      <bpmn:incoming>flowSpec</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="call" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
