<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-ENG-34: the SUPPORTED twin of test-mi-on-container-parse.bpmn — the same multi-instance
     markers on the two element kinds that DO implement them (serviceTask, userTask), no container.
     It is the control for the refusal: same construct, supported kind, still deploys. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_mitasks" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="mi-on-tasks" name="mi-on-tasks" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="miService" />
    <bpmn:serviceTask id="miService" name="miService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mi-service-job" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>2</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="miService" targetRef="miUser" />
    <bpmn:userTask id="miUser" name="miUser">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>2</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f3" name="f3" sourceRef="miUser" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>