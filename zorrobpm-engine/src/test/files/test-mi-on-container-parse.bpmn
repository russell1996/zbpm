<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-34 (CTO HOLD п.4): the same multiInstanceLoopCharacteristics on all four
     element kinds. The parser attaches it to userTask/serviceTask only, so the two
     container elements parse as ORDINARY containers — which is what makes the
     interrupting-boundary MI branch unreachable for them. The control pair in the
     same fixture proves the parser did not drop MI everywhere. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_micontainer" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="mi-on-container-parse" name="mi-on-container-parse" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="miSub" />

    <bpmn:subProcess id="miSub" name="miSub">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>2</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="subStart" name="subStart">
        <bpmn:outgoing>subF1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="subF1" name="subF1" sourceRef="subStart" targetRef="subWork" />
      <bpmn:userTask id="subWork" name="subWork">
        <bpmn:incoming>subF1</bpmn:incoming>
        <bpmn:outgoing>subF2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="subF2" name="subF2" sourceRef="subWork" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd" name="subEnd">
        <bpmn:incoming>subF2</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="miSub" targetRef="miCall" />

    <bpmn:callActivity id="miCall" name="miCall">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>2</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="f3" name="f3" sourceRef="miCall" targetRef="miService" />

    <bpmn:serviceTask id="miService" name="miService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mi-service-job" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>2</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f4" name="f4" sourceRef="miService" targetRef="miUser" />

    <bpmn:userTask id="miUser" name="miUser">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>2</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f5" name="f5" sourceRef="miUser" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>