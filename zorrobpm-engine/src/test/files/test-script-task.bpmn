<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_script" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-script-task" name="test-script-task" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="scriptSum" />

    <bpmn:scriptTask id="scriptSum" name="scriptSum" scriptFormat="feel" resultVariable="sum">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:script>a + b</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="scriptSum" targetRef="scriptGreater" />

    <bpmn:scriptTask id="scriptGreater" name="scriptGreater" scriptFormat="feel" resultVariable="greater">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:script>a &gt; b</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="flow3" name="flow3" sourceRef="scriptGreater" targetRef="scriptShout" />

    <bpmn:scriptTask id="scriptShout" name="scriptShout" scriptFormat="feel" resultVariable="shout">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
      <bpmn:script>upper case(name)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="flow4" name="flow4" sourceRef="scriptShout" targetRef="endEvent" />

    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
