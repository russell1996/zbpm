<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_send_zeebe" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-send-task-zeebe" name="test-send-task-zeebe" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="send" />

    <bpmn:sendTask id="send" name="send">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-worker" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="send" targetRef="endEvent" />

    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
