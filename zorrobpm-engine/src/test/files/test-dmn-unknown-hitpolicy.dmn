<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_unknown_hp" name="unknown-hitpolicy-test" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="unknownHitPolicyDecision" name="Unknown Hit Policy Decision">
    <decisionTable id="DecisionTable_unknown_hp" hitPolicy="BOGUS">
      <input id="Input_1" label="Score">
        <inputExpression id="InputExpression_1" typeRef="number" expressionLanguage="feel">
          <text>score</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Grade" name="grade" typeRef="string" />
      <rule id="Rule_1">
        <inputEntry id="In_1"><text>&gt;= 50</text></inputEntry>
        <outputEntry id="Out_1"><text>"A"</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <inputEntry id="In_2"><text>&gt;= 50</text></inputEntry>
        <outputEntry id="Out_2"><text>"B"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
