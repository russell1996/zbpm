<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_eng23_svc_wait" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- WO-ENG-23: linear flow that stays LIVE after svc completes (parks at the
       user task), so resolveIncident re-execution runs on a live instance.
       svc and the manual loop-visit rows share token + element id. -->
  <bpmn:process id="test-eng-23-svc-then-wait" name="test-eng-23-svc-then-wait" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="svc" />
    <bpmn:serviceTask id="svc" name="svc">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flaky" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="svc" targetRef="wait" />
    <bpmn:userTask id="wait" name="wait">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:outgoing>flow3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow3" name="flow3" sourceRef="wait" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
