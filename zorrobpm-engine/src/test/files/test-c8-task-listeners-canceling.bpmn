<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_c8tlc" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c8-task-listeners-canceling" name="c8-task-listeners-canceling" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="review" />
    <bpmn:userTask id="review" name="review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="alice" />
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="canceling" type="canceling-job" />
        </zeebe:taskListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="review" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="reviewTimer" name="reviewTimer" attachedToRef="review" cancelActivity="true">
      <bpmn:outgoing>flowB</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_b">
        <bpmn:timeDuration>PT10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="reviewTimer" targetRef="escalationEnd" />
    <bpmn:endEvent id="escalationEnd" name="escalationEnd">
      <bpmn:incoming>flowB</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
