<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-41 parity S8a: mirror of oracle s8a (MI sub inside MI sub).
     Zeebe facts: outer oitem visible inside; inner loopCounter shadows outer;
     dump sees outerResults=[[1,2],[1,2]], NO innerResults. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="defs-c841-s8a" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c841s8a" name="S8a nested MI" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="outerSub" />
    <bpmn:subProcess id="outerSub" name="outer">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=[&quot;x&quot;, &quot;y&quot;]" inputElement="oitem"
                                     outputCollection="outerResults" outputElement="=innerResults" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:startEvent id="outerStart"><bpmn:outgoing>of1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sequenceFlow id="of1" sourceRef="outerStart" targetRef="innerSub" />
      <bpmn:subProcess id="innerSub" name="inner">
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=[&quot;1&quot;, &quot;2&quot;]" inputElement="iitem"
                                       outputCollection="innerResults" outputElement="=iitem" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
        <bpmn:incoming>of1</bpmn:incoming>
        <bpmn:outgoing>of2</bpmn:outgoing>
        <bpmn:startEvent id="innerStart"><bpmn:outgoing>if1</bpmn:outgoing></bpmn:startEvent>
        <bpmn:sequenceFlow id="if1" sourceRef="innerStart" targetRef="w" />
        <bpmn:serviceTask id="w" name="w">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="c841s8aw" />
          </bpmn:extensionElements>
          <bpmn:incoming>if1</bpmn:incoming>
          <bpmn:outgoing>if2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="if2" sourceRef="w" targetRef="innerEnd" />
        <bpmn:endEvent id="innerEnd"><bpmn:incoming>if2</bpmn:incoming></bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="of2" sourceRef="innerSub" targetRef="outerEnd" />
      <bpmn:endEvent id="outerEnd"><bpmn:incoming>of2</bpmn:incoming></bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f2" sourceRef="outerSub" targetRef="dump" />
    <bpmn:serviceTask id="dump" name="dump">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="c841s8adump" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="dump" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
