<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_c834compscope" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c834-comp-scope" name="test-c834-comp-scope" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="outerWork" />
    <bpmn:scriptTask id="outerWork" name="outerWork" scriptFormat="feel" resultVariable="tmpO">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:script>1</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:boundaryEvent id="bOuter" name="bOuter" attachedToRef="outerWork">
      <bpmn:compensateEventDefinition id="ced_outer" />
    </bpmn:boundaryEvent>
    <bpmn:association id="assocOuter" sourceRef="bOuter" targetRef="outerHandler" />
    <bpmn:scriptTask id="outerHandler" name="outerHandler" scriptFormat="feel" resultVariable="log" isForCompensation="true">
      <bpmn:script>log * 10 + 9</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="outerWork" targetRef="sub1" />
    <bpmn:subProcess id="sub1" name="sub1">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:startEvent id="subStart" name="subStart">
        <bpmn:outgoing>subFlow1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="subFlow1" name="subFlow1" sourceRef="subStart" targetRef="innerWork" />
      <bpmn:scriptTask id="innerWork" name="innerWork" scriptFormat="feel" resultVariable="tmpI">
        <bpmn:incoming>subFlow1</bpmn:incoming>
        <bpmn:outgoing>subFlow2</bpmn:outgoing>
        <bpmn:script>2</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:boundaryEvent id="bInner" name="bInner" attachedToRef="innerWork">
        <bpmn:compensateEventDefinition id="ced_inner" />
      </bpmn:boundaryEvent>
      <bpmn:association id="assocInner" sourceRef="bInner" targetRef="innerHandler" />
      <bpmn:scriptTask id="innerHandler" name="innerHandler" scriptFormat="feel" resultVariable="log" isForCompensation="true">
        <bpmn:script>log * 10 + 1</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="subFlow2" name="subFlow2" sourceRef="innerWork" targetRef="subThrow" />
      <bpmn:intermediateThrowEvent id="subThrow" name="subThrow">
        <bpmn:incoming>subFlow2</bpmn:incoming>
        <bpmn:outgoing>subFlow3</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="ced_subthrow" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="subFlow3" name="subFlow3" sourceRef="subThrow" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd" name="subEnd">
        <bpmn:incoming>subFlow3</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f3" name="f3" sourceRef="sub1" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
