<?xml version="1.0" encoding="UTF-8"?>
<!--
  WO-OPS-34: нормально завершённый инстанс не должен оставлять подписок.

  Две РАЗНЫЕ подписки одного инстанса, обе — «вооружены» на живом инстансе
  и должны умереть вместе с ним:
    1) signal-boundary на mainTask (activity_id = строка mainTask) — подписка
       границы; C37-3 гасит message-подписки завершённого хоста, но НЕ signal-;
    2) signal-started event sub-process (activity_id = NULL) — подписка
       event-subprocess, она переживает любой отдельный хост по замыслу.

  Основной поток: start → mainTask → mainEnd. Ни сигнал, ни сообщение не
  приходят — инстанс завершается НОРМАЛЬНО (completed_at, не отменён), и после
  этого обе подписки обязаны быть удалены.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ops34" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:signal id="sigOps34" name="ops34Sig" />
  <bpmn:process id="test-ops34-completed-subscriptions" name="test-ops34-completed-subscriptions" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="mainTask" />
    <bpmn:userTask id="mainTask" name="mainTask">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="sigBnd" name="sigBnd" attachedToRef="mainTask">
      <bpmn:signalEventDefinition id="sedBnd" signalRef="sigOps34" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="mainTask" targetRef="mainEnd" />
    <bpmn:endEvent id="mainEnd" name="mainEnd">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:subProcess id="sigHandler" name="sigHandler" triggeredByEvent="true">
      <bpmn:startEvent id="evStart" name="evStart" isInterrupting="false">
        <bpmn:outgoing>flowE1</bpmn:outgoing>
        <bpmn:signalEventDefinition id="sedEv" signalRef="sigOps34" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="flowE1" name="flowE1" sourceRef="evStart" targetRef="evEnd" />
      <bpmn:endEvent id="evEnd" name="evEnd">
        <bpmn:incoming>flowE1</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>
</bpmn:definitions>
