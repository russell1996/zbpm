<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_script_invalid" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-script-task-invalid" name="test-script-task-invalid" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="scriptBad" />

    <bpmn:scriptTask id="scriptBad" name="scriptBad" scriptFormat="feel" resultVariable="result">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:script>a +</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="scriptBad" targetRef="endEvent" />

    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
