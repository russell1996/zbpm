<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_c835_nsbound" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c835-notstarted-host-bnd-incl-join" name="test-c835-notstarted-host-bnd-incl-join" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="pfork" />

    <!-- Диаграмма red-team BLOCKER-6 ДОСЛОВНО
         (WO-C8-35-independent-review-r4.md, §BLOCKER-6):
         pfork -> { taskA -> gC -> join ; taskSvc -> taskX -> endX }
         tmrX — таймерная граница на taskX, ЕЩЁ НЕ взведённая (пока жив taskSvc) — -> fB -> join.
         join — inclusive, 2 входа (gC, fB) -> taskNotify -> end.

         Наблюдение red-team (живой прогон): taskA завершён → join COMPLETED=1 и
         taskNotify CREATED=1 РАНЬШЕ ВРЕМЕНИ; после завершения taskSvc и реального выстрела
         таймера — join COMPLETED=2, taskNotify CREATED=2, инцидентов 0. Тихая двойная
         бизнес-побочка. Причина: armed-гейт пропускал ребро границы, если граница не взведена
         на АКТИВНОМ хосте, — а хост taskX ещё не начал, и живое вышестоящее исполнение
         (taskSvc) его запустит. -->
    <bpmn:parallelGateway id="pfork" name="pfork">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>fc</bpmn:outgoing>
      <bpmn:outgoing>fd</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="fc" name="fc" sourceRef="pfork" targetRef="taskA" />
    <bpmn:sequenceFlow id="fd" name="fd" sourceRef="pfork" targetRef="taskSvc" />

    <bpmn:userTask id="taskA" name="taskA">
      <bpmn:incoming>fc</bpmn:incoming>
      <bpmn:outgoing>gC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="gC" name="gC" sourceRef="taskA" targetRef="join" />

    <!-- Ветвь, у которой ДО join ещё один шаг: taskX не взведёт свою границу, пока
         taskSvc не завершится. Никакого armed-состояния на taskX в этот момент нет. -->
    <bpmn:userTask id="taskSvc" name="taskSvc">
      <bpmn:incoming>fd</bpmn:incoming>
      <bpmn:outgoing>fSvc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fSvc" name="fSvc" sourceRef="taskSvc" targetRef="taskX" />
    <bpmn:userTask id="taskX" name="taskX">
      <bpmn:incoming>fSvc</bpmn:incoming>
      <bpmn:outgoing>fXEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fXEnd" name="fXEnd" sourceRef="taskX" targetRef="endX" />
    <bpmn:endEvent id="endX" name="endX">
      <bpmn:incoming>fXEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:boundaryEvent id="tmrX" name="tmrX" attachedToRef="taskX" cancelActivity="false">
      <bpmn:outgoing>fB</bpmn:outgoing>
      <bpmn:timerEventDefinition id="tmrXDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="fB" name="fB" sourceRef="tmrX" targetRef="join" />

    <bpmn:inclusiveGateway id="join" name="join">
      <bpmn:incoming>gC</bpmn:incoming>
      <bpmn:incoming>fB</bpmn:incoming>
      <bpmn:outgoing>fNotify</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="fNotify" name="fNotify" sourceRef="join" targetRef="taskNotify" />
    <bpmn:userTask id="taskNotify" name="taskNotify">
      <bpmn:incoming>fNotify</bpmn:incoming>
      <bpmn:outgoing>fEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fEnd" name="fEnd" sourceRef="taskNotify" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>