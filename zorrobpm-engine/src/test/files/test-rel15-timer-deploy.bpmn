<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_rel15_timer" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="rel15-timer-deploy" name="rel15-timer-deploy" isExecutable="true">
    <bpmn:startEvent id="rel15TimerStart" name="rel15TimerStart">
      <bpmn:outgoing>flow1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="rel15TimerStart" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
