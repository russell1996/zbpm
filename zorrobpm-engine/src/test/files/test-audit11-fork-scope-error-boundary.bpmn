<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_a11f" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:error id="bizErr" name="Business Error" errorCode="E-1" />
  <bpmn:process id="test-audit11-fork-scope-error-boundary" name="test-audit11-fork-scope-error-boundary" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="sub1" />

    <bpmn:subProcess id="sub1" name="sub1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:startEvent id="subStart" name="subStart">
        <bpmn:outgoing>subFlow1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="subFlow1" name="subFlow1" sourceRef="subStart" targetRef="fork" />

      <bpmn:parallelGateway id="fork" name="fork">
        <bpmn:incoming>subFlow1</bpmn:incoming>
        <bpmn:outgoing>forkA</bpmn:outgoing>
        <bpmn:outgoing>forkB</bpmn:outgoing>
      </bpmn:parallelGateway>

      <bpmn:sequenceFlow id="forkA" name="forkA" sourceRef="fork" targetRef="errEnd" />
      <bpmn:endEvent id="errEnd" name="errEnd">
        <bpmn:incoming>forkA</bpmn:incoming>
        <bpmn:errorEventDefinition id="ed1" errorRef="bizErr" />
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="forkB" name="forkB" sourceRef="fork" targetRef="siblingTask" />
      <bpmn:serviceTask id="siblingTask" name="siblingTask">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="a11Sibling" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>forkB</bpmn:incoming>
        <bpmn:outgoing>forkBEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="forkBEnd" name="forkBEnd" sourceRef="siblingTask" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd" name="subEnd">
        <bpmn:incoming>forkBEnd</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>

    <bpmn:boundaryEvent id="errBoundary" name="errBoundary" attachedToRef="sub1">
      <bpmn:outgoing>flowB</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ed2" errorRef="bizErr" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="errBoundary" targetRef="afterBoundary" />
    <bpmn:serviceTask id="afterBoundary" name="afterBoundary">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="a11AfterBoundary" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowB</bpmn:incoming>
      <bpmn:outgoing>flow3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow3" name="flow3" sourceRef="afterBoundary" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="sub1" targetRef="endEvent" />
  </bpmn:process>
</bpmn:definitions>
