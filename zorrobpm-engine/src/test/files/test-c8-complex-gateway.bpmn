<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_c8cg" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c8-complex-gateway" name="c8-complex-gateway" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="cg" />
    <bpmn:complexGateway id="cg" name="cg">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:complexGateway>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="cg" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
