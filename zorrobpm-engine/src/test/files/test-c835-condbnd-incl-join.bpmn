<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_c835_condbnd" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c835-condbnd-incl-join" name="test-c835-condbnd-incl-join" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="pfork" />

    <!-- Диаграмма red-team BLOCKER-3 ДОСЛОВНО (WO-C8-35-independent-review-r3.md, §BLOCKER-3):
         pfork -> { taskA -> gC -> join ; taskHold + НЕПРЕРЫВАЮЩИЙ condB (abort = "true")
                             -> fBnd -> join ; taskFlag }.
         Наблюдение red-team: join COMPLETED=1 и taskAfter CREATED=1 уже после taskA (1-й приход
         из 2), потом после abort=true — join COMPLETED=2, taskAfter CREATED=2. Тихая двойная
         бизнес-побочка. Причина: у CONDITIONAL-границы НЕТ персистентной armed-записи (в отличие
         от timer/message/signal), а canReach шёл только по sequence-потокам хоста, хотя граница
         привязана через attachedToRef. -->
    <bpmn:parallelGateway id="pfork" name="pfork">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>fc</bpmn:outgoing>
      <bpmn:outgoing>fHold</bpmn:outgoing>
      <bpmn:outgoing>fFlag</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="fc" name="fc" sourceRef="pfork" targetRef="taskA" />
    <bpmn:sequenceFlow id="fHold" name="fHold" sourceRef="pfork" targetRef="taskHold" />
    <bpmn:sequenceFlow id="fFlag" name="fFlag" sourceRef="pfork" targetRef="taskFlag" />

    <bpmn:userTask id="taskA" name="taskA">
      <bpmn:incoming>fc</bpmn:incoming>
      <bpmn:outgoing>gC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="gC" name="gC" sourceRef="taskA" targetRef="join" />

    <bpmn:userTask id="taskHold" name="taskHold">
      <bpmn:incoming>fHold</bpmn:incoming>
      <bpmn:outgoing>fHoldEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fHoldEnd" name="fHoldEnd" sourceRef="taskHold" targetRef="endHold" />
    <bpmn:endEvent id="endHold" name="endHold">
      <bpmn:incoming>fHoldEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- НЕПРЕРЫВАЮЩАЯ условная граница на ЖИВОМ хосте: пока taskHold жив, condB может
         выстрелить ещё раз, то есть хост — возможный доставщик ветви в join. -->
    <bpmn:boundaryEvent id="condB" name="condB" attachedToRef="taskHold" cancelActivity="false">
      <bpmn:outgoing>fBnd</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="condB1">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">abort = true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="fBnd" name="fBnd" sourceRef="condB" targetRef="join" />

    <bpmn:userTask id="taskFlag" name="taskFlag">
      <bpmn:incoming>fFlag</bpmn:incoming>
      <bpmn:outgoing>fFlagEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fFlagEnd" name="fFlagEnd" sourceRef="taskFlag" targetRef="endFlag" />
    <bpmn:endEvent id="endFlag" name="endFlag">
      <bpmn:incoming>fFlagEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:inclusiveGateway id="join" name="join">
      <bpmn:incoming>gC</bpmn:incoming>
      <bpmn:incoming>fBnd</bpmn:incoming>
      <bpmn:outgoing>fAfter</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="fAfter" name="fAfter" sourceRef="join" targetRef="taskAfter" />
    <bpmn:userTask id="taskAfter" name="taskAfter">
      <bpmn:incoming>fAfter</bpmn:incoming>
      <bpmn:outgoing>fEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fEnd" name="fEnd" sourceRef="taskAfter" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>