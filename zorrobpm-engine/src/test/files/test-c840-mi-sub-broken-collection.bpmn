<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="defs-c840-broken" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- WO-C8-40: битое inputCollection (не коллекция) — инцидент по паттерну
       WO-C8-30 (resolve-or-incident), не падение и не тишина. -->
  <bpmn:process id="miSubProcessBroken" name="MI subprocess broken collection" isExecutable="true">
    <bpmn:startEvent id="startRepro">
      <bpmn:outgoing>flowStart</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flowStart" sourceRef="startRepro" targetRef="subProbe" />
    <bpmn:subProcess id="subProbe" name="probe">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=42" inputElement="item"
                                     outputCollection="results" outputElement="=item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:incoming>flowStart</bpmn:incoming>
      <bpmn:outgoing>flowSubDone</bpmn:outgoing>
      <bpmn:startEvent id="startProbe">
        <bpmn:outgoing>flowProbeStart</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="utProbe" name="probe">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="=item" />
        </bpmn:extensionElements>
        <bpmn:incoming>flowProbeStart</bpmn:incoming>
        <bpmn:outgoing>flowProbeDone</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="flowProbeStart" sourceRef="startProbe" targetRef="utProbe" />
      <bpmn:sequenceFlow id="flowProbeDone" sourceRef="utProbe" targetRef="endProbe" />
      <bpmn:endEvent id="endProbe">
        <bpmn:incoming>flowProbeDone</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flowSubDone" sourceRef="subProbe" targetRef="endRepro" />
    <bpmn:endEvent id="endRepro">
      <bpmn:incoming>flowSubDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
