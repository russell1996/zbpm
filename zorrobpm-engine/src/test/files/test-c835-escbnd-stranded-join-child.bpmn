<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_c835_escchild" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Ребёнок для диаграммы BLOCKER-4 (ESCALATION). Ворк не падает мгновенно: сначала
       cTask, чтобы родитель успел припарковать join, и только потом бросает escalation. -->
  <bpmn:escalation id="esc1" name="overdue" escalationCode="ESC-1" />
  <bpmn:process id="test-c835-escbnd-stranded-join-child" name="test-c835-escbnd-stranded-join-child" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="cTask" />
    <bpmn:userTask id="cTask" name="cTask">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>fToThrow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fToThrow" name="fToThrow" sourceRef="cTask" targetRef="escThrow" />
    <bpmn:intermediateThrowEvent id="escThrow" name="escThrow">
      <bpmn:incoming>fToThrow</bpmn:incoming>
      <bpmn:outgoing>fToEnd</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="eed1" escalationRef="esc1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="fToEnd" name="fToEnd" sourceRef="escThrow" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
