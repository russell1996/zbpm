  <bpmn:message id="pingMsg" name="ping" />
  <bpmn:process id="c8-job-throw" name="c8-job-throw" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="msgThrow" />
    <bpmn:intermediateThrowEvent id="msgThrow" name="msgThrow">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med1" messageRef="pingMsg" />
      <bpmn:extensionElements>
