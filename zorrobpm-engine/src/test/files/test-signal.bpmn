<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_sig" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:signal id="goSignal" name="go" />
  <bpmn:process id="test-signal" name="test-signal" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="parallel1" />
    <bpmn:parallelGateway id="parallel1" name="parallel1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flowA</bpmn:outgoing>
      <bpmn:outgoing>flowB</bpmn:outgoing>
      <bpmn:outgoing>flowC</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="flowA" name="flowA" sourceRef="parallel1" targetRef="signalCatchA" />
    <bpmn:intermediateCatchEvent id="signalCatchA" name="signalCatchA">
      <bpmn:incoming>flowA</bpmn:incoming>
      <bpmn:outgoing>flowA2</bpmn:outgoing>
      <bpmn:signalEventDefinition id="sedA" signalRef="goSignal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="flowA2" name="flowA2" sourceRef="signalCatchA" targetRef="endA" />
    <bpmn:endEvent id="endA" name="endA">
      <bpmn:incoming>flowA2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="parallel1" targetRef="signalCatchB" />
    <bpmn:intermediateCatchEvent id="signalCatchB" name="signalCatchB">
      <bpmn:incoming>flowB</bpmn:incoming>
      <bpmn:outgoing>flowB2</bpmn:outgoing>
      <bpmn:signalEventDefinition id="sedB" signalRef="goSignal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="flowB2" name="flowB2" sourceRef="signalCatchB" targetRef="endB" />
    <bpmn:endEvent id="endB" name="endB">
      <bpmn:incoming>flowB2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flowC" name="flowC" sourceRef="parallel1" targetRef="gate" />
    <bpmn:userTask id="gate" name="gate">
      <bpmn:incoming>flowC</bpmn:incoming>
      <bpmn:outgoing>flowC2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flowC2" name="flowC2" sourceRef="gate" targetRef="signalThrow" />
    <bpmn:intermediateThrowEvent id="signalThrow" name="signalThrow">
      <bpmn:incoming>flowC2</bpmn:incoming>
      <bpmn:outgoing>flowC3</bpmn:outgoing>
      <bpmn:signalEventDefinition id="sedThrow" signalRef="goSignal" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="flowC3" name="flowC3" sourceRef="signalThrow" targetRef="endC" />
    <bpmn:endEvent id="endC" name="endC">
      <bpmn:incoming>flowC3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
