<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_evsub_sig" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:signal id="sig_cancel" name="cancelSig" />
  <bpmn:process id="test-event-subprocess-signal" name="test-event-subprocess-signal" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="split" />
    <bpmn:parallelGateway id="split" name="split">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flowA</bpmn:outgoing>
      <bpmn:outgoing>flowB</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="flowA" name="flowA" sourceRef="split" targetRef="mainTask" />
    <bpmn:userTask id="mainTask" name="mainTask">
      <bpmn:incoming>flowA</bpmn:incoming>
      <bpmn:outgoing>flowA2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flowA2" name="flowA2" sourceRef="mainTask" targetRef="mainEnd" />
    <bpmn:endEvent id="mainEnd" name="mainEnd">
      <bpmn:incoming>flowA2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="split" targetRef="sigThrow" />
    <bpmn:intermediateThrowEvent id="sigThrow" name="sigThrow">
      <bpmn:incoming>flowB</bpmn:incoming>
      <bpmn:outgoing>flowB2</bpmn:outgoing>
      <bpmn:signalEventDefinition id="sed1" signalRef="sig_cancel" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="flowB2" name="flowB2" sourceRef="sigThrow" targetRef="throwEnd" />
    <bpmn:endEvent id="throwEnd" name="throwEnd">
      <bpmn:incoming>flowB2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:subProcess id="cancelHandler" name="cancelHandler" triggeredByEvent="true">
      <bpmn:startEvent id="evStart" name="evStart" isInterrupting="true">
        <bpmn:outgoing>flowE1</bpmn:outgoing>
        <bpmn:signalEventDefinition id="sed2" signalRef="sig_cancel" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="flowE1" name="flowE1" sourceRef="evStart" targetRef="evEnd" />
      <bpmn:endEvent id="evEnd" name="evEnd">
        <bpmn:incoming>flowE1</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>
</bpmn:definitions>
