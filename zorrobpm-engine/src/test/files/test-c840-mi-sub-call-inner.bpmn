<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="defs-c840-callinmi" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- WO-C8-40, критерий 8: callActivity внутри MI-подпроцесса — каждый инстанс
       зовёт дочерний процесс; дочерняя задача видит inputMapping из scope
       инстанса (=item → assigneeIn); по завершении дочерних задач инстансы
       собираются, outputCollection в порядке. -->
  <bpmn:process id="miSubProcessCallInner" name="MI subprocess with call activity" isExecutable="true">
    <bpmn:startEvent id="startRepro">
      <bpmn:outgoing>flowStart</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flowStart" sourceRef="startRepro" targetRef="subProbe" />
    <bpmn:subProcess id="subProbe" name="probe">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=[&quot;a&quot;, &quot;b&quot;]" inputElement="item"
                                     outputCollection="results" outputElement="=item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:incoming>flowStart</bpmn:incoming>
      <bpmn:outgoing>flowSubDone</bpmn:outgoing>
      <bpmn:startEvent id="startProbe">
        <bpmn:outgoing>flowProbeStart</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:callActivity id="callWork" name="callWork">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="c840-call-child" propagateAllParentVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=item" target="assigneeIn" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>flowProbeStart</bpmn:incoming>
        <bpmn:outgoing>flowProbeDone</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="flowProbeStart" sourceRef="startProbe" targetRef="callWork" />
      <bpmn:sequenceFlow id="flowProbeDone" sourceRef="callWork" targetRef="endProbe" />
      <bpmn:endEvent id="endProbe">
        <bpmn:incoming>flowProbeDone</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flowSubDone" sourceRef="subProbe" targetRef="endRepro" />
    <bpmn:endEvent id="endRepro">
      <bpmn:incoming>flowSubDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
