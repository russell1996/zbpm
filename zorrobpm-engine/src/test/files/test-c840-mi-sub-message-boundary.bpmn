<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="defs-c840-msgbnd" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="cancelMsg" name="cancel-order" />
  <!-- WO-C8-40, критерий 8: interrupting message boundary на MI-подпроцессе —
       корреляция гасит ВСЕ инстансы и их внутренности (cancelMiSubProcess),
       поток идёт с границы. Два инстанса: в каждом открыта utProbe. -->
  <bpmn:process id="miSubProcessMsgBnd" name="MI subprocess message boundary" isExecutable="true">
    <bpmn:startEvent id="startRepro">
      <bpmn:outgoing>flowStart</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flowStart" sourceRef="startRepro" targetRef="subProbe" />
    <bpmn:subProcess id="subProbe" name="probe">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=[&quot;a&quot;, &quot;b&quot;]" inputElement="item"
                                     outputCollection="results" outputElement="=item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:incoming>flowStart</bpmn:incoming>
      <bpmn:outgoing>flowSubDone</bpmn:outgoing>
      <bpmn:startEvent id="startProbe">
        <bpmn:outgoing>flowProbeStart</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="utProbe" name="probe">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="=item" />
        </bpmn:extensionElements>
        <bpmn:incoming>flowProbeStart</bpmn:incoming>
        <bpmn:outgoing>flowProbeDone</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="flowProbeStart" sourceRef="startProbe" targetRef="utProbe" />
      <bpmn:sequenceFlow id="flowProbeDone" sourceRef="utProbe" targetRef="endProbe" />
      <bpmn:endEvent id="endProbe">
        <bpmn:incoming>flowProbeDone</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="msgBnd" name="msgBnd" attachedToRef="subProbe" cancelActivity="true">
      <bpmn:outgoing>flowBndOut</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med1" messageRef="cancelMsg" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowSubDone" sourceRef="subProbe" targetRef="endRepro" />
    <bpmn:sequenceFlow id="flowBndOut" sourceRef="msgBnd" targetRef="endAfter" />
    <bpmn:endEvent id="endRepro">
      <bpmn:incoming>flowSubDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endAfter">
      <bpmn:incoming>flowBndOut</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
