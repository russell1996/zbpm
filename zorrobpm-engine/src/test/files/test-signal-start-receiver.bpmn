<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_sigsr" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:signal id="kickoffSig" name="kickoff" />
  <bpmn:process id="test-signal-start-receiver" name="test-signal-start-receiver" isExecutable="true">
    <bpmn:startEvent id="signalStart" name="signalStart">
      <bpmn:outgoing>flow1</bpmn:outgoing>
      <bpmn:signalEventDefinition id="sedStart" signalRef="kickoffSig" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="signalStart" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
