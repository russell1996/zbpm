<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_eng29_input" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- WO-ENG-29: input mapping referencing a variable that was never set —
       must raise an incident on activation, not a silent "" task variable. -->
  <bpmn:process id="test-eng29-missing-input" name="test-eng29-missing-input" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="svcIn" />

    <bpmn:serviceTask id="svcIn" name="svcIn">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="eng29-in" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=neverProvidedVar" target="inCopy"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="svcIn" targetRef="endEvent" />

    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
