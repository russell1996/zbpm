<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_c835_b2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c835-cond-upstream-incl-join" name="test-c835-cond-upstream-incl-join" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="pfork" />

    <!-- WO-C8-35 (B2, red-team BLOCKER-2): a live execution upstream of a CONDITIONAL gateway
         whose false branch also feeds the join. With "false conditions count as reachable" alone
         the join waits forever; the re-check on the death of the last possible deliverer
         (taskReject completing) is what lets it fire. -->
    <bpmn:parallelGateway id="pfork" name="pfork">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>fPrep</bpmn:outgoing>
      <bpmn:outgoing>fValid</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="fPrep" name="fPrep" sourceRef="pfork" targetRef="taskPrepare" />
    <bpmn:sequenceFlow id="fValid" name="fValid" sourceRef="pfork" targetRef="taskValidate" />

    <bpmn:userTask id="taskPrepare" name="taskPrepare">
      <bpmn:incoming>fPrep</bpmn:incoming>
      <bpmn:outgoing>gD</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="gD" name="gD" sourceRef="taskPrepare" targetRef="join" />

    <bpmn:userTask id="taskValidate" name="taskValidate">
      <bpmn:incoming>fValid</bpmn:incoming>
      <bpmn:outgoing>fXor</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fXor" name="fXor" sourceRef="taskValidate" targetRef="xor2" />

    <bpmn:exclusiveGateway id="xor2" name="xor2" default="fNg">
      <bpmn:incoming>fXor</bpmn:incoming>
      <bpmn:outgoing>fOk</bpmn:outgoing>
      <bpmn:outgoing>fNg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="fOk" name="fOk" sourceRef="xor2" targetRef="join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fNg" name="fNg" sourceRef="xor2" targetRef="taskReject" />
    <bpmn:userTask id="taskReject" name="taskReject">
      <bpmn:incoming>fNg</bpmn:incoming>
      <bpmn:outgoing>fRejectEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fRejectEnd" name="fRejectEnd" sourceRef="taskReject" targetRef="endReject" />
    <bpmn:endEvent id="endReject" name="endReject">
      <bpmn:incoming>fRejectEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:inclusiveGateway id="join" name="join">
      <bpmn:incoming>gD</bpmn:incoming>
      <bpmn:incoming>fOk</bpmn:incoming>
      <bpmn:outgoing>fAfter</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="fAfter" name="fAfter" sourceRef="join" targetRef="taskAfter" />
    <bpmn:userTask id="taskAfter" name="taskAfter">
      <bpmn:incoming>fAfter</bpmn:incoming>
      <bpmn:outgoing>fEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fEnd" name="fEnd" sourceRef="taskAfter" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
