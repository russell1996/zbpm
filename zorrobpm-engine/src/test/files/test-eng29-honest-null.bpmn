<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_eng29_null" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- WO-ENG-29: explicit FEEL null literal — legitimate null, must keep the
       pre-fix behaviour ("" STRING variable, no exception, no incident) on
       BOTH the input and the output path. -->
  <bpmn:process id="test-eng29-honest-null" name="test-eng29-honest-null" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="svcNull" />

    <bpmn:serviceTask id="svcNull" name="svcNull">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="eng29-null" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="nullIn"/>
          <zeebe:output source="=null" target="nullEcho"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="svcNull" targetRef="endEvent" />

    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
