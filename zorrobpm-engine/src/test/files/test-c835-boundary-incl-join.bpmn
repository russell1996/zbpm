<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_c835_b1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c835-boundary-incl-join" name="test-c835-boundary-incl-join" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="pfork" />

    <!-- WO-C8-35 (B1, red-team BLOCKER-1): the second arrival into the join comes from an ARMED
         non-interrupting boundary timer. That boundary has NO activity row while it waits, so a
         readiness rule built on active activities alone fires the join on arrival #1 and then
         AGAIN when the boundary arrives — taskNotify created twice, no incident. -->
    <bpmn:parallelGateway id="pfork" name="pfork">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>fc</bpmn:outgoing>
      <bpmn:outgoing>fd</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="fc" name="fc" sourceRef="pfork" targetRef="taskMain" />
    <bpmn:sequenceFlow id="fd" name="fd" sourceRef="pfork" targetRef="taskWait" />

    <bpmn:userTask id="taskMain" name="taskMain">
      <bpmn:incoming>fc</bpmn:incoming>
      <bpmn:outgoing>fC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fC" name="fC" sourceRef="taskMain" targetRef="join" />

    <bpmn:userTask id="taskWait" name="taskWait">
      <bpmn:incoming>fd</bpmn:incoming>
      <bpmn:outgoing>fWaitEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fWaitEnd" name="fWaitEnd" sourceRef="taskWait" targetRef="endWait" />
    <bpmn:endEvent id="endWait" name="endWait">
      <bpmn:incoming>fWaitEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:boundaryEvent id="tmrCheck" name="tmrCheck" attachedToRef="taskWait" cancelActivity="false">
      <bpmn:outgoing>gB</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="gB" name="gB" sourceRef="tmrCheck" targetRef="taskHold" />
    <bpmn:userTask id="taskHold" name="taskHold">
      <bpmn:incoming>gB</bpmn:incoming>
      <bpmn:outgoing>fHoldEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fHoldEnd" name="fHoldEnd" sourceRef="taskHold" targetRef="endHold" />
    <bpmn:endEvent id="endHold" name="endHold">
      <bpmn:incoming>fHoldEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:inclusiveGateway id="join" name="join">
      <bpmn:incoming>fC</bpmn:incoming>
      <bpmn:incoming>gB</bpmn:incoming>
      <bpmn:outgoing>fNotify</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="fNotify" name="fNotify" sourceRef="join" targetRef="taskNotify" />
    <bpmn:userTask id="taskNotify" name="taskNotify">
      <bpmn:incoming>fNotify</bpmn:incoming>
      <bpmn:outgoing>fEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fEnd" name="fEnd" sourceRef="taskNotify" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
