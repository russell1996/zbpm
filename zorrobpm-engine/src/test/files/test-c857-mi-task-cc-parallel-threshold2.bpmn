<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-57 (F-15), комбинация «threshold = 2 из 3»: MI-задача из ТРЁХ элементов,
     условие =numberOfCompletedInstances >= 2 → ТРЕТИЙ инстанс терминируется после
     ВТОРОГО завершения (частичная конвергенция: не 1-й, не последний, а средний
     момент). Zeebe 8.5: те же «Any instances that are still active are terminated»;
     results = ["a","b",null]. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="defs-c857-thr2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c857Thr2" name="C857 MI task completionCondition (2 of 3)" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="miTask" />
    <bpmn:serviceTask id="miTask" name="miTask">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="c857thr2w" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=[&quot;a&quot;,&quot;b&quot;,&quot;c&quot;]" inputElement="item"
                                     outputCollection="results" outputElement="=item" />
        </bpmn:extensionElements>
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">=numberOfCompletedInstances &gt;= 2</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="miTask" targetRef="dump" />
    <bpmn:serviceTask id="dump" name="dump">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="c857thr2dump" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="dump" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
