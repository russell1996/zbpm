<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_inc" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-inclusive-gateway" name="test-inclusive-gateway" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="split" />
    <bpmn:inclusiveGateway id="split" name="split" default="flowDefault">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flowA</bpmn:outgoing>
      <bpmn:outgoing>flowB</bpmn:outgoing>
      <bpmn:outgoing>flowDefault</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:sequenceFlow id="flowA" name="flowA" sourceRef="split" targetRef="join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=a = "yes"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="split" targetRef="join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=b = "yes"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowDefault" name="flowDefault" sourceRef="split" targetRef="join" />

    <bpmn:inclusiveGateway id="join" name="join">
      <bpmn:incoming>flowA</bpmn:incoming>
      <bpmn:incoming>flowB</bpmn:incoming>
      <bpmn:incoming>flowDefault</bpmn:incoming>
      <bpmn:outgoing>flowEnd</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="flowEnd" name="flowEnd" sourceRef="join" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flowEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
