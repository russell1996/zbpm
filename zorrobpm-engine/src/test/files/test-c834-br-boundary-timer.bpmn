<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-34 (CR-04): PT1H boundary timer on a BUSINESS RULE task host
     (FEEL expression, no DMN deployment needed). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_c834brtimer" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c834-br-boundary-timer" name="c834-br-boundary-timer" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="decide1" />
    <bpmn:businessRuleTask id="decide1" name="decide1">
      <bpmn:extensionElements>
        <zeebe:script expression="= 1 + 1" resultVariable="doubled" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:boundaryEvent id="brTimeout" name="brTimeout" attachedToRef="decide1">
      <bpmn:outgoing>fTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="tedBr">
        <bpmn:timeDuration>PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="decide1" targetRef="endEvent" />
    <bpmn:sequenceFlow id="fTimeout" name="fTimeout" sourceRef="brTimeout" targetRef="endTimeout" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endTimeout" name="endTimeout">
      <bpmn:incoming>fTimeout</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>