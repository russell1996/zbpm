<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_collect_sum" name="collect-sum-test" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="collectSumDecision" name="Collect Sum Decision">
    <decisionTable id="DecisionTable_collectsum" hitPolicy="COLLECT" aggregation="SUM">
      <input id="Input_1" label="Score">
        <inputExpression id="InputExpression_1" typeRef="number" expressionLanguage="feel">
          <text>score</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Points" name="points" typeRef="number" />
      <rule id="Rule_1">
        <inputEntry id="In_1"><text>&gt;= 10</text></inputEntry>
        <outputEntry id="Out_1"><text>10</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <inputEntry id="In_2"><text>&gt;= 20</text></inputEntry>
        <outputEntry id="Out_2"><text>20</text></outputEntry>
      </rule>
      <rule id="Rule_3">
        <inputEntry id="In_3"><text>&gt;= 30</text></inputEntry>
        <outputEntry id="Out_3"><text>30</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
