<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_collect_sum_decimal" name="collect-sum-decimal-test" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="collectSumDecimalDecision" name="Collect Sum Decimal Decision">
    <decisionTable id="DecisionTable_collectsumdecimal" hitPolicy="COLLECT" aggregation="SUM">
      <input id="Input_1" label="Score">
        <inputExpression id="InputExpression_1" typeRef="number" expressionLanguage="feel">
          <text>score</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Points" name="points" typeRef="number" />
      <!-- WO-ENG-25 (NEW-06): дробные output'ы — 0.1 + 0.2 обязано дать ровно 0.3 -->
      <rule id="Rule_1">
        <inputEntry id="In_1"><text>&gt;= 0</text></inputEntry>
        <outputEntry id="Out_1"><text>0.1</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <inputEntry id="In_2"><text>&gt;= 1</text></inputEntry>
        <outputEntry id="Out_2"><text>0.2</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
