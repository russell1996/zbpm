<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_c835_micondbnd" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c835-mi-condbnd-incl-join" name="test-c835-mi-condbnd-incl-join" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="pfork" />

    <!-- Диаграмма к БЛОКИРУЮЩЕЙ №1 red-team раунда 5 (WO-C8-35-independent-review-r5.md):
         pfork -> { miTask (parallel MI, 2 копии) -> endMi ; taskFlag -> fFlag -> join },
         condMi (НЕПРЕРЫВАЮЩАЯ conditional-граница на MI-хосте) -> fBnd -> join.
         Ключевое: у MI-хоста НЕТ исходящего потока в join — единственное ребро от живой
         копии к join идёт через границу condMi. Завершена 1 копия (строки COMPLETED +
         CREATED одного elementId — штатные смешанные строки, WO-ENG-23), затем деактивация
         taskFlag. Старый findDeadElementIds видел ЛЮБУЮ нетерминальную строку и объявлял
         хост мёртвым при живой копии -> condMi исключалась из «ещё может доставить» ->
         join срабатывал на приходе taskFlag (COMPLETED=1 при ЖИВОМ хосте), а по границе —
         ВТОРЫМ. Правильно: join ждёт, пока жива хоть одна копия (NOT EXISTS живая строка),
         и срабатывает РОВНО ОДИН РАЗ, когда умрёт последняя. -->
    <bpmn:parallelGateway id="pfork" name="pfork">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>fMi</bpmn:outgoing>
      <bpmn:outgoing>fFlag</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="fMi" name="fMi" sourceRef="pfork" targetRef="miTask" />
    <bpmn:sequenceFlow id="fFlag" name="fFlag" sourceRef="pfork" targetRef="taskFlag" />

    <bpmn:userTask id="miTask" name="miTask">
      <bpmn:incoming>fMi</bpmn:incoming>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>2</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:outgoing>fMiEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fMiEnd" name="fMiEnd" sourceRef="miTask" targetRef="endMi" />
    <bpmn:endEvent id="endMi" name="endMi">
      <bpmn:incoming>fMiEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- НЕПРЕРЫВАЮЩАЯ условная граница на MI-хосте: условие `go = true` никогда не
         выставляется (тест не передаёт переменных), поэтому граница не стреляет — она
         важна как РЕБРО «живая копия -> join», а не как выстрел. -->
    <bpmn:boundaryEvent id="condMi" name="condMi" attachedToRef="miTask" cancelActivity="false">
      <bpmn:outgoing>fBnd</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="condMi1">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">go = true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="fBnd" name="fBnd" sourceRef="condMi" targetRef="join" />

    <bpmn:userTask id="taskFlag" name="taskFlag">
      <bpmn:incoming>fFlag</bpmn:incoming>
      <bpmn:outgoing>fFlagJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fFlagJoin" name="fFlagJoin" sourceRef="taskFlag" targetRef="join" />

    <bpmn:inclusiveGateway id="join" name="join">
      <bpmn:incoming>fFlagJoin</bpmn:incoming>
      <bpmn:incoming>fBnd</bpmn:incoming>
      <bpmn:outgoing>fAfter</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="fAfter" name="fAfter" sourceRef="join" targetRef="taskAfter" />
    <bpmn:userTask id="taskAfter" name="taskAfter">
      <bpmn:incoming>fAfter</bpmn:incoming>
      <bpmn:outgoing>fEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fEnd" name="fEnd" sourceRef="taskAfter" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
