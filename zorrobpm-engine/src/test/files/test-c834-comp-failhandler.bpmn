<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_c834compfail" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c834-comp-failhandler" name="test-c834-comp-failhandler" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="work" />
    <bpmn:serviceTask id="work" name="work">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="comp-wait-job" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="bWork" name="bWork" attachedToRef="work">
      <bpmn:compensateEventDefinition id="ced_work" />
    </bpmn:boundaryEvent>
    <bpmn:association id="assocWork" sourceRef="bWork" targetRef="compHandler" />
    <bpmn:serviceTask id="compHandler" name="compHandler" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="comp-handler-job" retries="0" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="work" targetRef="compThrow" />
    <bpmn:intermediateThrowEvent id="compThrow" name="compThrow">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="ced_throw" waitForCompletion="true" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="f3" name="f3" sourceRef="compThrow" targetRef="afterComp" />
    <bpmn:scriptTask id="afterComp" name="afterComp" scriptFormat="feel" resultVariable="done">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:script>1</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="f4" name="f4" sourceRef="afterComp" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
