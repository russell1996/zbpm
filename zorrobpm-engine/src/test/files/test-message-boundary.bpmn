<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_msgb" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="cancelMsg" name="cancel-order" />
  <bpmn:process id="test-message-boundary" name="test-message-boundary" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="userTask1" />
    <bpmn:userTask id="userTask1" name="userTask1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="userTask1" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="msgBoundary" name="msgBoundary" attachedToRef="userTask1" cancelActivity="true">
      <bpmn:outgoing>flowB</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med1" messageRef="cancelMsg" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="msgBoundary" targetRef="boundaryEnd" />
    <bpmn:endEvent id="boundaryEnd" name="boundaryEnd">
      <bpmn:incoming>flowB</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
