<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_c835_failsvc" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-c835-failed-svc-last-deliverer-incl-join" name="test-c835-failed-svc-last-deliverer-incl-join" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="pfork" />

    <!-- Топология для хвоста failSharedBudget (CompletionService.failSharedBudget): форк, где
         второй ветвью идёт СЕРВИСНАЯ ЗАДАЧА taskSvc, её бюджет ретраев исчерпан (0), поэтому
         failServiceTask уходит по пути «errorActivity + createIncident + хвост резюма», а НЕ
         по re-dispatch (re-dispatch оставил бы задачу жить, и join ждал бы правильно).
         taskSvc объявляет zeebe:retries="0", чтобы ветка была исчерпана сразу.

         pfork -> { taskA -> gC -> join ; taskSvc -> join }, join — inclusive, 2 входа,
         1 выход -> taskAfter -> end.

         Что доказывает тест: taskA приходит в join и паркует его (taskSvc ЖИВ, достижим по графу).
         Затем taskSvc падает с исчерпанным бюджетом — она умирает, то есть умирает ПОСЛЕДНИЙ
         возможный доставщик. Без резюма в хвосте failSharedBudget припаркованный join не
         просыпался бы НИКОГДА (та же форма, что BLOCKER-4 на ErrorEscalationThrower).
         Раньше этот сайт резюма не был защищён ничем (@verifier раунда 7, оформительская находка 6). -->
    <bpmn:parallelGateway id="pfork" name="pfork">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>fA</bpmn:outgoing>
      <bpmn:outgoing>fSvc</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="fA" name="fA" sourceRef="pfork" targetRef="taskA" />
    <bpmn:sequenceFlow id="fSvc" name="fSvc" sourceRef="pfork" targetRef="taskSvc" />

    <bpmn:userTask id="taskA" name="taskA">
      <bpmn:incoming>fA</bpmn:incoming>
      <bpmn:outgoing>gC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="gC" name="gC" sourceRef="taskA" targetRef="join" />

    <bpmn:serviceTask id="taskSvc" name="taskSvc">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="failSvc" retries="0" />
      </bpmn:extensionElements>
      <bpmn:incoming>fSvc</bpmn:incoming>
      <bpmn:outgoing>fSvcJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fSvcJoin" name="fSvcJoin" sourceRef="taskSvc" targetRef="join" />

    <bpmn:inclusiveGateway id="join" name="join">
      <bpmn:incoming>gC</bpmn:incoming>
      <bpmn:incoming>fSvcJoin</bpmn:incoming>
      <bpmn:outgoing>fAfter</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="fAfter" name="fAfter" sourceRef="join" targetRef="taskAfter" />
    <bpmn:userTask id="taskAfter" name="taskAfter">
      <bpmn:incoming>fAfter</bpmn:incoming>
      <bpmn:outgoing>fEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fEnd" name="fEnd" sourceRef="taskAfter" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
