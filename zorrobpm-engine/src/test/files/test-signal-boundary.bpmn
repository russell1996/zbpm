<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_sigb" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:signal id="cancelSig" name="cancel" />
  <bpmn:process id="test-signal-boundary" name="test-signal-boundary" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="parallel1" />
    <bpmn:parallelGateway id="parallel1" name="parallel1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flowA</bpmn:outgoing>
      <bpmn:outgoing>flowB</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="flowA" name="flowA" sourceRef="parallel1" targetRef="gate1" />
    <bpmn:userTask id="gate1" name="gate1">
      <bpmn:incoming>flowA</bpmn:incoming>
      <bpmn:outgoing>flowA2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flowA2" name="flowA2" sourceRef="gate1" targetRef="endA" />
    <bpmn:endEvent id="endA" name="endA">
      <bpmn:incoming>flowA2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:boundaryEvent id="sigBoundary" name="sigBoundary" attachedToRef="gate1" cancelActivity="true">
      <bpmn:outgoing>flowBnd</bpmn:outgoing>
      <bpmn:signalEventDefinition id="sedBnd" signalRef="cancelSig" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flowBnd" name="flowBnd" sourceRef="sigBoundary" targetRef="boundaryEnd" />
    <bpmn:endEvent id="boundaryEnd" name="boundaryEnd">
      <bpmn:incoming>flowBnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="parallel1" targetRef="gate2" />
    <bpmn:userTask id="gate2" name="gate2">
      <bpmn:incoming>flowB</bpmn:incoming>
      <bpmn:outgoing>flowB2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flowB2" name="flowB2" sourceRef="gate2" targetRef="signalThrow" />
    <bpmn:intermediateThrowEvent id="signalThrow" name="signalThrow">
      <bpmn:incoming>flowB2</bpmn:incoming>
      <bpmn:outgoing>flowB3</bpmn:outgoing>
      <bpmn:signalEventDefinition id="sedThrow" signalRef="cancelSig" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="flowB3" name="flowB3" sourceRef="signalThrow" targetRef="endB" />
    <bpmn:endEvent id="endB" name="endB">
      <bpmn:incoming>flowB3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
