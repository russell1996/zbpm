<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_msgstart" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="orderMsg" name="order-received" />
  <bpmn:process id="test-message-start" name="test-message-start" isExecutable="true">
    <bpmn:startEvent id="msgStart" name="msgStart">
      <bpmn:outgoing>flow1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med1" messageRef="orderMsg" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="msgStart" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
