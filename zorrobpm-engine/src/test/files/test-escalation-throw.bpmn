<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_esct" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:escalation id="esc1" name="overdue" escalationCode="ESC-1" />
  <bpmn:process id="test-escalation-throw" name="test-escalation-throw" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="escThrow" />
    <bpmn:intermediateThrowEvent id="escThrow" name="escThrow">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="eed1" escalationRef="esc1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="escThrow" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
