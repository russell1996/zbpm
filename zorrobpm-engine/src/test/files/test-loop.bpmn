<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_loop" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-loop" name="test-loop" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="parallel1" />
    <bpmn:parallelGateway id="parallel1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="parallel1" targetRef="parallel1" />
    <bpmn:endEvent id="endEvent" name="endEvent" />
  </bpmn:process>
</bpmn:definitions>
