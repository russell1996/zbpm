<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-35 (CR-09, criterion 2): a DECOY join on one branch's path, whose own
     second branch NEVER RUNS in this scenario (it hangs off an XOR whose condition
     selected the other branch).

     That is what makes the topology discriminating: the old first-match BFS wrote
     `expected = 2` (the split activated two branches) onto decoyJoin, and decoyJoin
     then waited for a second arrival that could never come — so d1 never reached the
     REAL join, whose counter was never written, and the process hung. With the
     convergent-join rule the counter lands on `join` (both split branches reach it),
     the decoy has no counter and fires on reachability (nobody else can reach it),
     and the tail completes. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_c835decoy" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c835-decoy-incl-join" name="c835-decoy-incl-join" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="split" />
    <bpmn:inclusiveGateway id="split" name="split">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>spA</bpmn:outgoing>
      <bpmn:outgoing>spB</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="spA" name="spA" sourceRef="split" targetRef="taskA" />
    <bpmn:sequenceFlow id="spB" name="spB" sourceRef="split" targetRef="xor1" />
    <bpmn:userTask id="taskA" name="taskA">
      <bpmn:incoming>spA</bpmn:incoming>
      <bpmn:outgoing>a1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="xor1" name="xor1">
      <bpmn:incoming>spB</bpmn:incoming>
      <bpmn:outgoing>toB</bpmn:outgoing>
      <bpmn:outgoing>toC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toB" name="toB" sourceRef="xor1" targetRef="taskB">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pick = "B"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toC" name="toC" sourceRef="xor1" targetRef="taskC">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pick = "C"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="taskB" name="taskB">
      <bpmn:incoming>toB</bpmn:incoming>
      <bpmn:outgoing>b1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="taskC" name="taskC">
      <bpmn:incoming>toC</bpmn:incoming>
      <bpmn:outgoing>x1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="a1" name="a1" sourceRef="taskA" targetRef="decoyJoin" />
    <bpmn:sequenceFlow id="b1" name="b1" sourceRef="taskB" targetRef="join" />
    <bpmn:sequenceFlow id="x1" name="x1" sourceRef="taskC" targetRef="decoyJoin" />
    <bpmn:inclusiveGateway id="decoyJoin" name="decoyJoin">
      <bpmn:incoming>a1</bpmn:incoming>
      <bpmn:incoming>x1</bpmn:incoming>
      <bpmn:outgoing>d1</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="d1" name="d1" sourceRef="decoyJoin" targetRef="join" />
    <bpmn:inclusiveGateway id="join" name="join">
      <bpmn:incoming>d1</bpmn:incoming>
      <bpmn:incoming>b1</bpmn:incoming>
      <bpmn:outgoing>fEnd</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="fEnd" name="fEnd" sourceRef="join" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>fEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
