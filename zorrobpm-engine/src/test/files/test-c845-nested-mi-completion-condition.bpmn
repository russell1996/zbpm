<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="defs-c845-d" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- WO-C8-45 (г): ВЛОЖЕННЫЙ MI (MI-подпроцесс в обычном подпроцессе) с
       completionCondition по results. Агрегация F3 пишет results в CONTAINING
       scope тела = скоуп subOuter (≠ root). На root-чтении условие никогда не
       срабатывает (RED: после сдачи b-ветки utAfter нет, инстанс ждёт вторую),
       на chain-чтении — ранний выход: сиблинг гасится (F4), utAfter создан
       (GREEN). FEEL-индексы 1-based: results[2] = "b" у второго элемента. -->
  <bpmn:process id="c845-nested-mi-cond" name="C845 nested MI completionCondition" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="subOuter" />
    <bpmn:subProcess id="subOuter" name="outer">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:startEvent id="outerStart"><bpmn:outgoing>of1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sequenceFlow id="of1" sourceRef="outerStart" targetRef="subMi" />
      <bpmn:subProcess id="subMi" name="mi">
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=[&quot;a&quot;, &quot;b&quot;]" inputElement="item"
                                       outputCollection="results" outputElement="=item" />
          </bpmn:extensionElements>
          <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">=results[2] = "b"</bpmn:completionCondition>
        </bpmn:multiInstanceLoopCharacteristics>
        <bpmn:incoming>of1</bpmn:incoming>
        <bpmn:outgoing>of2</bpmn:outgoing>
        <bpmn:startEvent id="miStart"><bpmn:outgoing>mf1</bpmn:outgoing></bpmn:startEvent>
        <bpmn:sequenceFlow id="mf1" sourceRef="miStart" targetRef="utInner" />
        <bpmn:userTask id="utInner" name="inner">
          <bpmn:extensionElements>
            <zeebe:userTask />
            <zeebe:assignmentDefinition assignee="=item" />
          </bpmn:extensionElements>
          <bpmn:incoming>mf1</bpmn:incoming>
          <bpmn:outgoing>mf2</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="mf2" sourceRef="utInner" targetRef="miEnd" />
        <bpmn:endEvent id="miEnd"><bpmn:incoming>mf2</bpmn:incoming></bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="of2" sourceRef="subMi" targetRef="outerEnd" />
      <bpmn:endEvent id="outerEnd"><bpmn:incoming>of2</bpmn:incoming></bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f2" sourceRef="subOuter" targetRef="utAfter" />
    <bpmn:userTask id="utAfter" name="after">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f3" sourceRef="utAfter" targetRef="end" />
    <bpmn:endEvent id="end"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
