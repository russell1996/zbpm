<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_diff2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-diff2-gateway-order" name="test-diff2-gateway-order" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="xor" />
    <!-- WO-DIFF-2 (Raxon S-016 shape): flowBig is declared FIRST, flowSmall LAST.
         At amount=150 BOTH conditions hold; the real Zeebe takes the LAST in
         document order (flowSmall -> endSmall, i.e. chosen=small). -->
    <bpmn:exclusiveGateway id="xor" name="xor">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flowBig</bpmn:outgoing>
      <bpmn:outgoing>flowSmall</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flowBig" name="flowBig" sourceRef="xor" targetRef="endBig">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=amount &gt; 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowSmall" name="flowSmall" sourceRef="xor" targetRef="endSmall">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=amount &lt; 200</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="endBig" name="endBig">
      <bpmn:incoming>flowBig</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endSmall" name="endSmall">
      <bpmn:incoming>flowSmall</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
