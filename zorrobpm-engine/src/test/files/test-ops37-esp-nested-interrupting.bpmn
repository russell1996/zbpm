<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-OPS-37: ВЛОЖЕННЫЙ прерывающий event sub-process (объявлен внутри
     подпроцесса). Он гасит свой РОДИТЕЛЬСКИЙ scope — поток внутри подпроцесса
     после броска сигнала не продолжается ("after" не создаётся), а ветвь ВНЕ
     подпроцесса живёт дальше (scope-confinement, как в Zeebe 8.5). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ops37_nested" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:signal id="sigOps37" name="ops37sig" />
  <bpmn:process id="test-ops37-esp-nested-interrupting" name="test-ops37-esp-nested-interrupting" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="split" />
    <bpmn:parallelGateway id="split" name="split">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flowA</bpmn:outgoing>
      <bpmn:outgoing>flowB</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="flowA" name="flowA" sourceRef="split" targetRef="sub" />
    <bpmn:sequenceFlow id="flowB" name="flowB" sourceRef="split" targetRef="outsideTask" />
    <bpmn:userTask id="outsideTask" name="outsideTask">
      <bpmn:incoming>flowB</bpmn:incoming>
      <bpmn:outgoing>flowB2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flowB2" name="flowB2" sourceRef="outsideTask" targetRef="outsideEnd" />
    <bpmn:endEvent id="outsideEnd" name="outsideEnd">
      <bpmn:incoming>flowB2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:subProcess id="sub" name="sub">
      <bpmn:startEvent id="subStart" name="subStart">
        <bpmn:outgoing>sf1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="sf1" name="sf1" sourceRef="subStart" targetRef="throwSig" />
      <bpmn:intermediateThrowEvent id="throwSig" name="throwSig">
        <bpmn:incoming>sf1</bpmn:incoming>
        <bpmn:outgoing>sf2</bpmn:outgoing>
        <bpmn:signalEventDefinition id="sed1" signalRef="sigOps37" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="sf2" name="sf2" sourceRef="throwSig" targetRef="after" />
      <bpmn:userTask id="after" name="after">
        <bpmn:incoming>sf2</bpmn:incoming>
        <bpmn:outgoing>sf3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="sf3" name="sf3" sourceRef="after" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd" name="subEnd">
        <bpmn:incoming>sf3</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:subProcess id="esp" name="esp" triggeredByEvent="true">
        <bpmn:startEvent id="evStart" name="evStart" isInterrupting="true">
          <bpmn:outgoing>ef1</bpmn:outgoing>
          <bpmn:signalEventDefinition id="sed2" signalRef="sigOps37" />
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="ef1" name="ef1" sourceRef="evStart" targetRef="evWork" />
        <bpmn:userTask id="evWork" name="evWork">
          <bpmn:incoming>ef1</bpmn:incoming>
          <bpmn:outgoing>ef2</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="ef2" name="ef2" sourceRef="evWork" targetRef="evEnd" />
        <bpmn:endEvent id="evEnd" name="evEnd">
          <bpmn:incoming>ef2</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flowA2" name="flowA2" sourceRef="sub" targetRef="mainEnd" />
    <bpmn:endEvent id="mainEnd" name="mainEnd">
      <bpmn:incoming>flowA2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
