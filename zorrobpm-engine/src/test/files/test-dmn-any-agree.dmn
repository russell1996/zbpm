<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_any_agree" name="any-agree-test" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="anyAgreeDecision" name="Any Agree Decision">
    <decisionTable id="DecisionTable_any_agree" hitPolicy="ANY">
      <input id="Input_1" label="Score">
        <inputExpression id="InputExpression_1" typeRef="number" expressionLanguage="feel">
          <text>score</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Grade" name="grade" typeRef="string" />
      <rule id="Rule_1">
        <inputEntry id="In_1"><text>&gt;= 50</text></inputEntry>
        <outputEntry id="Out_1"><text>"A"</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <inputEntry id="In_2"><text>&gt;= 50</text></inputEntry>
        <outputEntry id="Out_2"><text>"A"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="anyAgreeNumericDecision" name="Any Agree Numeric Decision">
    <decisionTable id="DecisionTable_any_agree_num" hitPolicy="ANY">
      <input id="Input_1" label="Score">
        <inputExpression id="InputExpression_1" typeRef="number" expressionLanguage="feel">
          <text>score</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Bonus" name="bonus" typeRef="number" />
      <rule id="Rule_1">
        <inputEntry id="In_1"><text>&gt;= 50</text></inputEntry>
        <outputEntry id="Out_1"><text>10</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <inputEntry id="In_2"><text>&gt;= 50</text></inputEntry>
        <outputEntry id="Out_2"><text>10.0</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
