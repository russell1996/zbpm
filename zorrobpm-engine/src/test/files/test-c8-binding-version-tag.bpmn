<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_c8btv" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c8-binding-version-tag" name="c8-binding-version-tag" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="call" />
    <bpmn:callActivity id="call" name="call">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="c8-callee-tagged" bindingType="versionTag" versionTag="v1" />
