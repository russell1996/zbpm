<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-34 (CR-04): PT1H boundary timer on an AD-HOC SUBPROCESS container host. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_c834adhoc" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c834-adhoc-boundary-timer" name="c834-adhoc-boundary-timer" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" name="f1" sourceRef="startEvent" targetRef="adhoc1" />
    <bpmn:adHocSubProcess id="adhoc1" name="adhoc1">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:adHoc activeElementsCollection="=[]" />
      </bpmn:extensionElements>
      <bpmn:userTask id="adhocWork" name="adhocWork" />
    </bpmn:adHocSubProcess>
    <bpmn:boundaryEvent id="adhocTimeout" name="adhocTimeout" attachedToRef="adhoc1">
      <bpmn:outgoing>fTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="tedAdhoc">
        <bpmn:timeDuration>PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f2" name="f2" sourceRef="adhoc1" targetRef="endEvent" />
    <bpmn:sequenceFlow id="fTimeout" name="fTimeout" sourceRef="adhocTimeout" targetRef="endTimeout" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endTimeout" name="endTimeout">
      <bpmn:incoming>fTimeout</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>