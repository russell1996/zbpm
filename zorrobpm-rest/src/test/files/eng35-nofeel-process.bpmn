<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_eng35nofeel" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- WO-ENG-35 раунд 2 (Б-2): процесс БЕЗ единого FEEL-выражения — ни скриптов,
       ни условий на потоках, ни io-mapping, ни назначений через выражения.
       start→userTask→end: claim/cancel такого инстанса никогда не доходят до
       script-пула, поэтому при забитом пуле обязаны отвечать 2xx, а не 503. -->
  <bpmn:process id="eng35-nofeel-process" name="eng35-nofeel-process" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="startEvent">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" name="flow1" sourceRef="startEvent" targetRef="userTask1" />
    <bpmn:userTask id="userTask1" name="userTask1">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow2" name="flow2" sourceRef="userTask1" targetRef="endEvent" />
    <bpmn:endEvent id="endEvent" name="endEvent">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
