<?xml version="1.0" encoding="UTF-8"?>
<!-- WO-C8-51 (часть A): live MI subprocess with one user task per body.
     Two parallel bodies ("a" and "b") hold item/loopCounter in their own
     activity scope, so the by-scope grouping and the progressive drop on body
     completion are observable from REST. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_c851" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c851-variables-by-scope" name="C851 Variables By Scope" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="miSub" />
    <bpmn:subProcess id="miSub" name="MI bodies">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=items" inputElement="item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:startEvent id="subStart">
        <bpmn:outgoing>sf1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="sf1" sourceRef="subStart" targetRef="innerTask" />
      <bpmn:userTask id="innerTask" name="Inner task">
        <bpmn:incoming>sf1</bpmn:incoming>
        <bpmn:outgoing>sf2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="sf2" sourceRef="innerTask" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd">
        <bpmn:incoming>sf2</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f2" sourceRef="miSub" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
