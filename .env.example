# Copy to .env and adjust. docker compose reads these automatically.
# In CI/CD these can instead be set as masked GitLab CI/CD variables.

# --- App (backend) ---
APP_PORT=8080
APP_TAG=latest

# --- Frontend (SPA + nginx) ---
# The external reverse proxy (https://zorro.i-smet.kz) forwards to this port.
FRONTEND_PORT=8081
FRONTEND_TAG=latest

# --- PostgreSQL ---
# NOTE (WO-SEC-27b): for a public prod, set a STRONG DB_PASSWORD (openssl rand -base64 32) and rotate the
# existing role (ALTER ROLE) — the default below is dev-only. Ports are bound to 127.0.0.1 (SEC-27a).
DB_NAME=zorrobpm-db
DB_USERNAME=zorrodev
DB_PASSWORD=zorrodev
DB_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USERNAME=zorrodev
RABBITMQ_PASSWORD=zorrodev
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=9300

# --- Security (REQUIRED in prod) ---
# App runs under the 'prod' profile by default (see docker-compose.yml).
# ZORROBPM_JWT_SECRET is MANDATORY: without it the app refuses to start (WO-SEC-9 fail-fast).
# Generate a strong one:  openssl rand -base64 48
ZORROBPM_JWT_SECRET=
# ZORROBPM_JWT_LEGACY_SECRETS — optional, WO-SEC-57: CSV of previously active JWT secrets,
# accepted for verification only (key rotation). Set it to the OLD secret while moving the NEW
# one into ZORROBPM_JWT_SECRET, wait one access-token TTL, then remove it. See
# governance/runbooks/jwt-key-rotation.md. Example:
# ZORROBPM_JWT_LEGACY_SECRETS=old-secret-1,old-secret-2
# ZORROBPM_DEFAULT_ADMIN_PASSWORD is MANDATORY: without it (or if left as "admin"), the app
# refuses to start (WO-SEC-14 fail-fast). Must be a secure password, NOT "admin".
ZORROBPM_DEFAULT_ADMIN_PASSWORD=
# Browser origins for the SPA (same-origin via nginx usually needs nothing extra):
ZORROBPM_CORS_ORIGINS=https://zorro.i-smet.kz
# Override profile only if you know what you're doing (default: prod):
# SPRING_PROFILES_ACTIVE=prod

# --- Observability (WO-OBS-2) ---
# Grafana admin password — REQUIRED if you use the observability overlay, otherwise the grafana container refuses to start (fail-fast like app).
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# Prometheus retention (overlay only)
PROMETHEUS_RETENTION=30d
# Prometheus UI external URL (overlay only, WO-OBS-4: UI served under /prometheus/).
# Must be the browser-reachable address of the nginx frontend on THIS host.
PROMETHEUS_EXTERNAL_URL=http://localhost:18081/prometheus/
# Grafana auth.proxy whitelist (overlay only, WO-OBS-4) — the nginx container's
# STATIC IP /32 (defined in docker-compose.yml: frontend.networks.zorrobpm.ipv4_address).
# Without it (or with a too-wide CIDR) anyone reaching Grafana directly bypasses
# ZBPM login. Fail-closed: wrong/absent value breaks proxy-auth back to the admin
# login form (criterion 6), never to open access.
GRAFANA_PROXY_WHITELIST=172.18.0.3/32
# Grafana alert webhook — OPTIONAL, OFF by default (principle 5). Set to a Telegram/Slack webhook URL to receive notifications.
# Example Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>  Slack: https://hooks.slack.com/services/...
# Leave empty to keep alerts in Grafana UI only (Firing without notification).
GRAFANA_ALERT_WEBHOOK_URL=
# OTel trace export (overlay only, WO-OBS-8) — OPTIONAL, OFF by default (empty → SDK
# no-op: spans minted and dropped, zero export traffic — the prod/CI default).
# Dev contour: point at the overlay Jaeger (OTLP/HTTP :4318). Sampling likewise
# env-only, e.g. OTEL_TRACES_SAMPLER=parentbased_always_on for a full dev trace.
OTEL_EXPORTER_OTLP_ENDPOINT=
