# Copy to .env and adjust. docker compose reads these automatically.
# In CI/CD these can instead be set as masked GitLab CI/CD variables.

# --- App (backend) ---
APP_PORT=8080
APP_TAG=latest

# --- Frontend (SPA + nginx) ---
# The external reverse proxy (https://zorro.i-smet.kz) forwards to this port.
FRONTEND_PORT=8081
FRONTEND_TAG=latest

# --- PostgreSQL ---
# NOTE (WO-SEC-27b): for a public prod, set a STRONG DB_PASSWORD (openssl rand -base64 32) and rotate the
# existing role (ALTER ROLE) — the default below is dev-only. Ports are bound to 127.0.0.1 (SEC-27a).
DB_NAME=zorrobpm-db
DB_USERNAME=zorrodev
DB_PASSWORD=zorrodev
DB_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USERNAME=zorrodev
RABBITMQ_PASSWORD=zorrodev
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=9300
# Management API base for per-system broker credential provisioning (WO-INT-9).
# OPTIONAL here — docker-compose.yml already defaults it correctly. Declare it ONLY
# if you must point the app at a different management endpoint, and mind the path:
# the broker runs with management.path_prefix = /rabbitmq (WO-QW-12, config
# ci/rabbitmq/conf.d/30-management-path-prefix.conf), so every management path —
# /api/users, /api/permissions — answers 404 WITHOUT that suffix. A wrong value here
# does not degrade gracefully: worker credential provisioning fails closed with 503.
# RABBITMQ_MGMT_BASE_URL=http://rabbitmq:15672/rabbitmq

# --- Security (REQUIRED in prod) ---
# App runs under the 'prod' profile by default (see docker-compose.yml).
# ZORROBPM_JWT_SECRET is MANDATORY: without it the app refuses to start (WO-SEC-9 fail-fast).
# Generate a strong one:  openssl rand -base64 48
ZORROBPM_JWT_SECRET=
# ZORROBPM_JWT_LEGACY_SECRETS — optional, WO-SEC-57: CSV of previously active JWT secrets,
# accepted for verification only (key rotation). Set it to the OLD secret while moving the NEW
# one into ZORROBPM_JWT_SECRET, wait one access-token TTL, then remove it. See
# docs/internal Example:
# ZORROBPM_JWT_LEGACY_SECRETS=old-secret-1,old-secret-2
# ZORROBPM_DEFAULT_ADMIN_PASSWORD is MANDATORY: without it (or if left as "admin"), the app
# refuses to start (WO-SEC-14 fail-fast). Must be a secure password, NOT "admin".
ZORROBPM_DEFAULT_ADMIN_PASSWORD=
# Browser origins for the SPA (same-origin via nginx usually needs nothing extra):
ZORROBPM_CORS_ORIGINS=https://zorro.i-smet.kz
# ZORROBPM_RATE_LIMIT_TRUSTED_PROXIES — the reverse proxy in front of the app (the frontend
# nginx container) whose X-Real-IP header may be trusted. All per-IP rate-limit budgets
# (login / refresh / auth-link / data) are keyed on the REAL client address only while the
# peer is trusted; behind an untrusted proxy they collapse into one shared bucket for the
# whole installation. Default 172.16.0.0/12 covers the standard Docker bridge pools — set
# the exact CIDR of the frontend container's network if the daemon uses custom pools.
# Same value is the compose default (docker-compose.yml: ZORROBPM_RATE_LIMIT_TRUSTED_PROXIES).
# ZORROBPM_RATE_LIMIT_TRUSTED_PROXIES=172.16.0.0/12
# Override profile only if you know what you're doing (default: prod):
# SPRING_PROFILES_ACTIVE=prod

# --- Retention: чистка таблиц events/outbox (WO-AUDIT-15, F-11) ---
# Код и properties были (WO-AUDIT-7), а ручек в docker-compose.yml/.env не было:
# значения не доезжали до контейнера, дефолт 0 (= выключено) оставался в силе,
# и таблицы events/outbox росли бесконечно. Теперь они проброшены.
#
# 0 = чистка ВЫКЛЮЧЕНА (безопасно по умолчанию). ВКЛЮЧЕНИЕ НА ПРОДЕ — РЕШЕНИЕ
# ВЛАДЕЛЬЦА, не исполнителя; порядок включения:
#   1) ZORROBPM_ENGINE_RETENTION_DRY_RUN=true — чистка только СЧИТАЕТ («удалил бы N»),
#      удаляет 0 строк; посмотрите лог "Retention dry-run: would delete N …";
#   2) выставить TTL и снять dry-run.
#
# Окно SSE catch-up: клиент, отвалившийся дольше events-TTL, при reconnect по
# Last-Event-ID получит дыру в ленте (его строки уже удалены). Живой подписчик
# прикрыт пином SseLiveCursorTracker, отключившийся — нет. Поэтому events-TTL
# должен быть не меньше максимального окна disconnected-клиента: 30 дней
# покрывает выходные и отпуск, меньше 7 дней почти наверняка рвёт ленту у
# мобильных клиентов. Outbox-TTL ограничен только историей доставки
# (опубликованные/карантинные строки), на catch-up он не влияет.
ZORROBPM_ENGINE_RETENTION_EVENTS_TTL_DAYS=0
ZORROBPM_ENGINE_RETENTION_OUTBOX_TTL_DAYS=0
ZORROBPM_ENGINE_RETENTION_DRY_RUN=false
ZORROBPM_ENGINE_RETENTION_BATCH_PAUSE_MS=0

# --- Observability (WO-OBS-2) ---
# Grafana admin password — REQUIRED if you use the observability overlay, otherwise the grafana container refuses to start (fail-fast like app).
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# Grafana public address (overlay only, WO-REL-61) — the protocol+domain Grafana believes
# it is served from (root_url). Browsers MUST reach Grafana at exactly this origin, otherwise
# Grafana 11's Origin-vs-root_url check 403s every POST /api/ds/query + the live websocket
# ("all dashboards no data", prod 2026-09-29).
# Dev: leave both unset → http://localhost (matches local nginx, same as before this change).
# Prod: GF_SERVER_PROTOCOL=https + GRAFANA_DOMAIN=<public domain, e.g. test-zbpm.telecom.kz>.
GF_SERVER_PROTOCOL=
GRAFANA_DOMAIN=
# Prometheus retention (overlay only)
PROMETHEUS_RETENTION=30d
# Prometheus UI external URL (overlay only, WO-OBS-4: UI served under /prometheus/).
# Must be the browser-reachable address of the nginx frontend on THIS host.
PROMETHEUS_EXTERNAL_URL=http://localhost:18081/prometheus/
# Grafana auth.proxy whitelist (overlay only, WO-OBS-4) — the nginx container's
# STATIC IP /32 (defined in docker-compose.yml: frontend.networks.zorrobpm.ipv4_address).
# Without it (or with a too-wide CIDR) anyone reaching Grafana directly bypasses
# ZBPM login. Fail-closed: wrong/absent value breaks proxy-auth back to the admin
# login form (criterion 6), never to open access.
GRAFANA_PROXY_WHITELIST=172.18.0.3/32
# Grafana alert webhook — OPTIONAL, OFF by default (principle 5). Set to a Telegram/Slack webhook URL to receive notifications.
# Example Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>  Slack: https://hooks.slack.com/services/...
# Leave empty to keep alerts in Grafana UI only (Firing without notification).
GRAFANA_ALERT_WEBHOOK_URL=
# OTel trace export (overlay only, WO-OBS-8) — OPTIONAL, OFF by default (empty → SDK
# no-op: spans minted and dropped, zero export traffic — the prod/CI default).
# Dev contour: point at the overlay Jaeger (OTLP/HTTP :4318). Sampling likewise
# env-only, e.g. OTEL_TRACES_SAMPLER=parentbased_always_on for a full dev trace.
OTEL_EXPORTER_OTLP_ENDPOINT=
