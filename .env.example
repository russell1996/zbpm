# Copy to .env and adjust. docker compose reads these automatically.
# In CI/CD these can instead be set as masked GitLab CI/CD variables.

# --- App (backend) ---
APP_PORT=8080
APP_TAG=latest

# --- Frontend (SPA + nginx) ---
# The external reverse proxy (https://zorro.i-smet.kz) forwards to this port.
FRONTEND_PORT=8081
FRONTEND_TAG=latest

# --- PostgreSQL ---
DB_NAME=zorrobpm-db
DB_USERNAME=zorrodev
DB_PASSWORD=zorrodev
DB_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USERNAME=zorrodev
RABBITMQ_PASSWORD=zorrodev
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=9300

# --- Security (REQUIRED in prod) ---
# App runs under the 'prod' profile by default (see docker-compose.yml).
# ZORROBPM_JWT_SECRET is MANDATORY: without it the app refuses to start (WO-SEC-9 fail-fast).
# Generate a strong one:  openssl rand -base64 48
ZORROBPM_JWT_SECRET=
# Browser origins for the SPA (same-origin via nginx usually needs nothing extra):
ZORROBPM_CORS_ORIGINS=https://zorro.i-smet.kz
# Override profile only if you know what you're doing (default: prod):
# SPRING_PROFILES_ACTIVE=prod
