# Copy to .env and adjust. docker compose reads these automatically.
# In CI/CD these can instead be set as masked GitLab CI/CD variables.

# --- App (backend) ---
APP_PORT=8080
APP_TAG=latest

# --- Frontend (SPA + nginx) ---
# The external reverse proxy (https://zorro.i-smet.kz) forwards to this port.
FRONTEND_PORT=8081
FRONTEND_TAG=latest

# --- PostgreSQL ---
DB_NAME=zorrobpm-db
DB_USERNAME=zorrodev
DB_PASSWORD=zorrodev
DB_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USERNAME=zorrodev
RABBITMQ_PASSWORD=zorrodev
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=9300
