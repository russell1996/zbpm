{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",

  // Auto-inject the durable operating rules into EVERY MiMoCode session, so they
  // are always in context and don't depend on the agent remembering to open them.
  // CONTRIBUTING.md is auto-loaded by MiMoCode already; this adds the standing prompt
  // (real-PG rule §1c, POF §1b, task-pool §2) and the live maintainer channel on top.
  "instructions": [
    "docs/internal",
    "docs/internal"
  ],

  // G-M enforcement: mechanical pre-done checklist injected every turn
  "plugin": [
    "./.mimocode/plugins/done-gate.js"
  ]

  // Recommended for higher code quality (set to a strong model available to you):
  //   "model": "<provider_id>/<model_id>",
  //   "small_model": "<provider_id>/<model_id>"
  // Left unset here so the environment/provider choice stays with the operator.
}
