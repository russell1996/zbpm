# Production build-time config (Vite inlines VITE_* at build).
# No localhost / IPs: API is a relative route served through nginx; the OIDC redirect
# falls back to window.location.origin (the production domain) when left empty.

# The production reverse proxy routes the domain root ("/") straight to the backend
# (https://zorro.i-smet.kz/process-instances works), but has no "/api" location. So the
# SPA targets the root directly instead of "/api" — no nginx change needed.
# (Dev still uses "/api" via the Vite proxy in vite.config.ts, which strips the prefix.)
VITE_API_URL=/

VITE_KEYCLOAK_URL=https://keycloak.example.com
VITE_KEYCLOAK_REALM=KT
VITE_KEYCLOAK_CLIENT_ID=zorrobpm-frontend
# Empty -> the app uses window.location.origin (e.g. https://zorro.i-smet.kz)
VITE_KEYCLOAK_REDIRECT_URI=
