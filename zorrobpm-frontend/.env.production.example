# Production build-time config (Vite inlines VITE_* at build).
# Copy this file to .env.production locally with real values when a production build
# actually needs them. Real .env.production must NOT be committed to git (WO-SEC-53 A1).
# No localhost / IPs: API is a relative route served through nginx; the OIDC redirect
# falls back to window.location.origin (the production domain) when left empty.

# The production reverse proxy routes the domain root ("/") straight to the backend
# (https://zorro.i-smet.kz/process-instances works), but has no "/api" location. So the
# SPA targets the root directly instead of "/api" — no nginx change needed.
# (Dev still uses "/api" via the Vite proxy in vite.config.ts, which strips the prefix.)
#
# WO-QW-1 F34: two supported topologies —
#   (a) external proxy (default): build with VITE_API_URL=/ (Dockerfile default);
#   (b) standalone `docker compose up`: the bundled nginx proxies /api/ → app:8080,
#       build with `docker build --build-arg VITE_API_URL=/api` (and keep api.ts
#       fallback '/api' for dev). S1 (CIDR placeholder in nginx.conf for rate-limit)
#       is a different issue — do not confuse the two.
VITE_API_URL=/

# Keycloak is NOT used by the current CE auth (self-contained JWT auth). These are
# placeholders only — replace with real values if an OIDC integration is ever wired up.
VITE_KEYCLOAK_URL=https://keycloak.example.com
VITE_KEYCLOAK_REALM=YOUR_REALM
VITE_KEYCLOAK_CLIENT_ID=zorrobpm-frontend
# Empty -> the app uses window.location.origin (e.g. https://zorro.i-smet.kz)
VITE_KEYCLOAK_REDIRECT_URI=
