    "/f2b/512kib": {
      "status": 200,
      "contentType": "application/json",
      "bodyMarker": "",
      "bodyBytes": 524288
    }
  },
  "cases": [
    {
      "id": "f2b-get-200-json",
      "group": "response-class",
      "title": "GET 200 application/json — успешный ответ",
      "docs89": "REST connector 8.9: коннектор завершает задание; в контексте ответа доступны status/body/headers; Result variable кладёт полный ответ в переменную процесса.",
      "job": {
        "type": "io.camunda:http-json:1",
        "variables": {
          "url": "{MOCK}/f2b/ok",
          "method": "GET",
          "headers": {
            "x-f2b-case": "f2b-get-200-json"
          }
        },
        "taskHeaders": {}
      },
      "expect": {
        "live": {
          "outcome": "completed"
        },
        "ours": {
          "outcome": "success",
          "httpStatus": 200,
          "httpBodyType": "JSON",
          "httpBodyContains": "zorro-f2b"
        },
        "request": {
          "method": "GET",
          "path": "/f2b/ok",
          "query": {},
          "headers": {
            "x-f2b-case": "f2b-get-200-json"
          }
        }
      },
      "note": "Базовая линия: обе стороны делают ОДИН GET и получают 200."
    },
